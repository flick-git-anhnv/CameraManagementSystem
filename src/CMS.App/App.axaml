<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CMS.App.App"
             RequestedThemeVariant="Dark">
    <Application.Styles>
        <FluentTheme />

        <!-- Load KZTEK tokens first so StyleInclude files can reference them -->
        <Styles>
            <Styles.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.MergedDictionaries>
                        <ResourceInclude Source="avares://KztekComponentAvalonia/Theme/KzTokens.axaml" />
                    </ResourceDictionary.MergedDictionaries>
                </ResourceDictionary>
            </Styles.Resources>
        </Styles>

        <!-- KZTEK Selector-based styles -->
        <StyleInclude Source="avares://KztekComponentAvalonia/Themes/KzDataGrid.axaml" />
        <StyleInclude Source="avares://KztekComponentAvalonia/Themes/KzTabControl.axaml" />
        <StyleInclude Source="avares://KztekComponentAvalonia/Themes/KzDateTimePicker.axaml" />
        <StyleInclude Source="avares://KztekComponentAvalonia/Themes/KzMenu.axaml" />

        <Style Selector="GridSplitter">
            <Setter Property="Background" Value="{DynamicResource ThemeNavBorderBrush}" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="GridSplitter:pointerover">
            <Setter Property="Background" Value="#F05922" />
        </Style>
        <Style Selector="GridSplitter:pressed">
            <Setter Property="Background" Value="#D94817" />
        </Style>
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- KZTEK Tokens + ControlThemes -->
                <ResourceInclude Source="avares://KztekComponentAvalonia/Themes/Default.axaml" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <!-- Surface & Backgrounds (KZTEK Dark Navy Palette) -->
                    <SolidColorBrush x:Key="ThemeBackgroundBrush" Color="#13111C"/>
                    <SolidColorBrush x:Key="ThemeNavBackgroundBrush" Color="#1E1B2E"/>
                    <SolidColorBrush x:Key="ThemeNavBorderBrush" Color="#2E2A45"/>
                    <SolidColorBrush x:Key="ThemeCardBackgroundBrush" Color="#1E1B2E"/>
                    <SolidColorBrush x:Key="ThemeCardSecondaryBackgroundBrush" Color="#26223B"/>
                    <SolidColorBrush x:Key="ThemeCardBorderBrush" Color="#342F50"/>
                    <SolidColorBrush x:Key="ThemeStatusBarBackgroundBrush" Color="#13111C"/>
                    <SolidColorBrush x:Key="ThemeStatusBarBorderBrush" Color="#2E2A45"/>
                    <SolidColorBrush x:Key="ThemeStatusBarForegroundBrush" Color="#C5C0E2"/>
                    <SolidColorBrush x:Key="ThemeStatusBarMutedForegroundBrush" Color="#8E88B0"/>
                    <SolidColorBrush x:Key="ThemeItemContainerBackgroundBrush" Color="#26223B"/>
                    <SolidColorBrush x:Key="ThemeItemContainerBorderBrush" Color="#383256"/>
                    
                    <!-- Typography -->
                    <SolidColorBrush x:Key="ThemeTextPrimaryBrush" Color="#F8FAFC"/>
                    <SolidColorBrush x:Key="ThemeTextSecondaryBrush" Color="#C5C0E2"/>
                    <SolidColorBrush x:Key="ThemeTextMutedBrush" Color="#8E88B0"/>
                    <SolidColorBrush x:Key="ThemeBrandBrush" Color="#F05922"/>

                    <!-- Buttons & Controls -->
                    <SolidColorBrush x:Key="ThemeNavButtonInactiveBackgroundBrush" Color="#26223B"/>
                    <SolidColorBrush x:Key="ThemeNavButtonInactiveForegroundBrush" Color="#C5C0E2"/>
                    <SolidColorBrush x:Key="ThemeButtonSecondaryBackgroundBrush" Color="#2E2A45"/>
                    <SolidColorBrush x:Key="ThemeButtonSecondaryForegroundBrush" Color="#F4F4F5"/>
                    <SolidColorBrush x:Key="ThemeButtonSecondaryBorderBrush" Color="#443E63"/>
                    <SolidColorBrush x:Key="ThemeNotificationBackgroundBrush" Color="#26223B"/>
                    <SolidColorBrush x:Key="ThemeNotificationForegroundBrush" Color="#F4F4F5"/>

                    <!-- Video & Timeline -->
                    <SolidColorBrush x:Key="ThemeVideoAreaBackgroundBrush" Color="#0A0910"/>
                    <SolidColorBrush x:Key="ThemeVideoCellPlaceholderBrush" Color="#171424"/>
                    <SolidColorBrush x:Key="ThemeTimelineBackgroundBrush" Color="#1E1B2E"/>
                    <SolidColorBrush x:Key="ThemeTimelineBorderBrush" Color="#2E2A45"/>
                    <SolidColorBrush x:Key="ThemeTimelineTickMajorBrush" Color="#645C8A"/>
                    <SolidColorBrush x:Key="ThemeTimelineTickMinorBrush" Color="#2E2A45"/>
                    <SolidColorBrush x:Key="ThemeTimelineTextBrush" Color="#8E88B0"/>

                    <!-- Badges -->
                    <SolidColorBrush x:Key="ThemeBadgeBrandBackgroundBrush" Color="#3B231A"/>
                    <SolidColorBrush x:Key="ThemeBadgeBrandForegroundBrush" Color="#FF8C5A"/>
                </ResourceDictionary>

                <ResourceDictionary x:Key="Light">
                    <!-- Surface & Backgrounds (KZTEK Light Palette) -->
                    <SolidColorBrush x:Key="ThemeBackgroundBrush" Color="#F5F3FA"/>
                    <SolidColorBrush x:Key="ThemeNavBackgroundBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="ThemeNavBorderBrush" Color="#E5E2EE"/>
                    <SolidColorBrush x:Key="ThemeCardBackgroundBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="ThemeCardSecondaryBackgroundBrush" Color="#F9F8FC"/>
                    <SolidColorBrush x:Key="ThemeCardBorderBrush" Color="#E5E2EE"/>
                    <SolidColorBrush x:Key="ThemeStatusBarBackgroundBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="ThemeStatusBarBorderBrush" Color="#E5E2EE"/>
                    <SolidColorBrush x:Key="ThemeStatusBarForegroundBrush" Color="#251C53"/>
                    <SolidColorBrush x:Key="ThemeStatusBarMutedForegroundBrush" Color="#6B7280"/>
                    <SolidColorBrush x:Key="ThemeItemContainerBackgroundBrush" Color="#F5F3FA"/>
                    <SolidColorBrush x:Key="ThemeItemContainerBorderBrush" Color="#E5E2EE"/>
                    
                    <!-- Typography -->
                    <SolidColorBrush x:Key="ThemeTextPrimaryBrush" Color="#251C53"/>
                    <SolidColorBrush x:Key="ThemeTextSecondaryBrush" Color="#4A3F8C"/>
                    <SolidColorBrush x:Key="ThemeTextMutedBrush" Color="#6B7280"/>
                    <SolidColorBrush x:Key="ThemeBrandBrush" Color="#F05922"/>

                    <!-- Buttons & Controls -->
                    <SolidColorBrush x:Key="ThemeNavButtonInactiveBackgroundBrush" Color="#F5F3FA"/>
                    <SolidColorBrush x:Key="ThemeNavButtonInactiveForegroundBrush" Color="#4A3F8C"/>
                    <SolidColorBrush x:Key="ThemeButtonSecondaryBackgroundBrush" Color="#ECE8F5"/>
                    <SolidColorBrush x:Key="ThemeButtonSecondaryForegroundBrush" Color="#251C53"/>
                    <SolidColorBrush x:Key="ThemeButtonSecondaryBorderBrush" Color="#D8D2E6"/>
                    <SolidColorBrush x:Key="ThemeNotificationBackgroundBrush" Color="#F5F3FA"/>
                    <SolidColorBrush x:Key="ThemeNotificationForegroundBrush" Color="#251C53"/>

                    <!-- Video & Timeline -->
                    <SolidColorBrush x:Key="ThemeVideoAreaBackgroundBrush" Color="#0F172A"/>
                    <SolidColorBrush x:Key="ThemeVideoCellPlaceholderBrush" Color="#1E293B"/>
                    <SolidColorBrush x:Key="ThemeTimelineBackgroundBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="ThemeTimelineBorderBrush" Color="#E5E2EE"/>
                    <SolidColorBrush x:Key="ThemeTimelineTickMajorBrush" Color="#94A3B8"/>
                    <SolidColorBrush x:Key="ThemeTimelineTickMinorBrush" Color="#E5E2EE"/>
                    <SolidColorBrush x:Key="ThemeTimelineTextBrush" Color="#64748B"/>

                    <!-- Badges -->
                    <SolidColorBrush x:Key="ThemeBadgeBrandBackgroundBrush" Color="#FFEDD5"/>
                    <SolidColorBrush x:Key="ThemeBadgeBrandForegroundBrush" Color="#C2410C"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
