<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CMS.App.App"
             RequestedThemeVariant="Dark">
    <Application.Styles>
        <FluentTheme />
        <Style Selector="GridSplitter">
            <Setter Property="Background" Value="#27272A" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="GridSplitter:pointerover">
            <Setter Property="Background" Value="#3B82F6" />
        </Style>
        <Style Selector="GridSplitter:pressed">
            <Setter Property="Background" Value="#2563EB" />
        </Style>
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <!-- Surface & Backgrounds -->
                    <SolidColorBrush x:Key="ThemeBackgroundBrush" Color="#09090B"/>
                    <SolidColorBrush x:Key="ThemeNavBackgroundBrush" Color="#18181B"/>
                    <SolidColorBrush x:Key="ThemeNavBorderBrush" Color="#27272A"/>
                    <SolidColorBrush x:Key="ThemeCardBackgroundBrush" Color="#18181B"/>
                    <SolidColorBrush x:Key="ThemeCardSecondaryBackgroundBrush" Color="#1E1E22"/>
                    <SolidColorBrush x:Key="ThemeCardBorderBrush" Color="#27272A"/>
                    <SolidColorBrush x:Key="ThemeStatusBarBackgroundBrush" Color="#0F172A"/>
                    <SolidColorBrush x:Key="ThemeStatusBarBorderBrush" Color="#1E293B"/>
                    <SolidColorBrush x:Key="ThemeStatusBarForegroundBrush" Color="#94A3B8"/>
                    <SolidColorBrush x:Key="ThemeStatusBarMutedForegroundBrush" Color="#64748B"/>
                    <SolidColorBrush x:Key="ThemeItemContainerBackgroundBrush" Color="#27272A"/>
                    <SolidColorBrush x:Key="ThemeItemContainerBorderBrush" Color="#333333"/>
                    
                    <!-- Typography -->
                    <SolidColorBrush x:Key="ThemeTextPrimaryBrush" Color="#F4F4F5"/>
                    <SolidColorBrush x:Key="ThemeTextSecondaryBrush" Color="#A1A1AA"/>
                    <SolidColorBrush x:Key="ThemeTextMutedBrush" Color="#71717A"/>
                    <SolidColorBrush x:Key="ThemeBrandBrush" Color="#3B82F6"/>

                    <!-- Buttons & Controls -->
                    <SolidColorBrush x:Key="ThemeNavButtonInactiveBackgroundBrush" Color="#27272A"/>
                    <SolidColorBrush x:Key="ThemeNavButtonInactiveForegroundBrush" Color="#A1A1AA"/>
                    <SolidColorBrush x:Key="ThemeButtonSecondaryBackgroundBrush" Color="#27272A"/>
                    <SolidColorBrush x:Key="ThemeButtonSecondaryForegroundBrush" Color="#E4E4E7"/>
                    <SolidColorBrush x:Key="ThemeButtonSecondaryBorderBrush" Color="#3F3F46"/>
                    <SolidColorBrush x:Key="ThemeNotificationBackgroundBrush" Color="#27272A"/>
                    <SolidColorBrush x:Key="ThemeNotificationForegroundBrush" Color="#E4E4E7"/>

                    <!-- Video & Timeline -->
                    <SolidColorBrush x:Key="ThemeVideoAreaBackgroundBrush" Color="#09090B"/>
                    <SolidColorBrush x:Key="ThemeVideoCellPlaceholderBrush" Color="#18181B"/>
                    <SolidColorBrush x:Key="ThemeTimelineBackgroundBrush" Color="#18181B"/>
                    <SolidColorBrush x:Key="ThemeTimelineBorderBrush" Color="#27272A"/>
                    <SolidColorBrush x:Key="ThemeTimelineTickMajorBrush" Color="#52525B"/>
                    <SolidColorBrush x:Key="ThemeTimelineTickMinorBrush" Color="#27272A"/>
                    <SolidColorBrush x:Key="ThemeTimelineTextBrush" Color="#71717A"/>

                    <!-- Badges -->
                    <SolidColorBrush x:Key="ThemeBadgeBrandBackgroundBrush" Color="#1E3A8A"/>
                    <SolidColorBrush x:Key="ThemeBadgeBrandForegroundBrush" Color="#93C5FD"/>
                </ResourceDictionary>

                <ResourceDictionary x:Key="Light">
                    <!-- Surface & Backgrounds -->
                    <SolidColorBrush x:Key="ThemeBackgroundBrush" Color="#F3F4F6"/>
                    <SolidColorBrush x:Key="ThemeNavBackgroundBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="ThemeNavBorderBrush" Color="#E5E7EB"/>
                    <SolidColorBrush x:Key="ThemeCardBackgroundBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="ThemeCardSecondaryBackgroundBrush" Color="#F8FAFC"/>
                    <SolidColorBrush x:Key="ThemeCardBorderBrush" Color="#E2E8F0"/>
                    <SolidColorBrush x:Key="ThemeStatusBarBackgroundBrush" Color="#F1F5F9"/>
                    <SolidColorBrush x:Key="ThemeStatusBarBorderBrush" Color="#CBD5E1"/>
                    <SolidColorBrush x:Key="ThemeStatusBarForegroundBrush" Color="#475569"/>
                    <SolidColorBrush x:Key="ThemeStatusBarMutedForegroundBrush" Color="#64748B"/>
                    <SolidColorBrush x:Key="ThemeItemContainerBackgroundBrush" Color="#F1F5F9"/>
                    <SolidColorBrush x:Key="ThemeItemContainerBorderBrush" Color="#E2E8F0"/>
                    
                    <!-- Typography -->
                    <SolidColorBrush x:Key="ThemeTextPrimaryBrush" Color="#111827"/>
                    <SolidColorBrush x:Key="ThemeTextSecondaryBrush" Color="#4B5563"/>
                    <SolidColorBrush x:Key="ThemeTextMutedBrush" Color="#6B7280"/>
                    <SolidColorBrush x:Key="ThemeBrandBrush" Color="#2563EB"/>

                    <!-- Buttons & Controls -->
                    <SolidColorBrush x:Key="ThemeNavButtonInactiveBackgroundBrush" Color="#F3F4F6"/>
                    <SolidColorBrush x:Key="ThemeNavButtonInactiveForegroundBrush" Color="#4B5563"/>
                    <SolidColorBrush x:Key="ThemeButtonSecondaryBackgroundBrush" Color="#E5E7EB"/>
                    <SolidColorBrush x:Key="ThemeButtonSecondaryForegroundBrush" Color="#1F2937"/>
                    <SolidColorBrush x:Key="ThemeButtonSecondaryBorderBrush" Color="#D1D5DB"/>
                    <SolidColorBrush x:Key="ThemeNotificationBackgroundBrush" Color="#F3F4F6"/>
                    <SolidColorBrush x:Key="ThemeNotificationForegroundBrush" Color="#1F2937"/>

                    <!-- Video & Timeline -->
                    <SolidColorBrush x:Key="ThemeVideoAreaBackgroundBrush" Color="#0F172A"/>
                    <SolidColorBrush x:Key="ThemeVideoCellPlaceholderBrush" Color="#1E293B"/>
                    <SolidColorBrush x:Key="ThemeTimelineBackgroundBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="ThemeTimelineBorderBrush" Color="#E5E7EB"/>
                    <SolidColorBrush x:Key="ThemeTimelineTickMajorBrush" Color="#94A3B8"/>
                    <SolidColorBrush x:Key="ThemeTimelineTickMinorBrush" Color="#E2E8F0"/>
                    <SolidColorBrush x:Key="ThemeTimelineTextBrush" Color="#64748B"/>

                    <!-- Badges -->
                    <SolidColorBrush x:Key="ThemeBadgeBrandBackgroundBrush" Color="#DBEAFE"/>
                    <SolidColorBrush x:Key="ThemeBadgeBrandForegroundBrush" Color="#1E40AF"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
