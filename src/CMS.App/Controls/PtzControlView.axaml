<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CMS.App.Controls.PtzControlView"
             Width="280">

    <Border Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="6" Padding="12">
        <StackPanel Spacing="10">
            <!-- Header -->
            <Grid ColumnDefinitions="*, Auto">
                <TextBlock Grid.Column="0" Text="PTZ CONTROLLER" FontWeight="Bold" FontSize="12" Foreground="#3B82F6"/>
                <TextBlock x:Name="TxtTargetCamera" Grid.Column="1" Text="No Camera" FontSize="11" Foreground="#A1A1AA"/>
            </Grid>

            <!-- Virtual 8-Way D-Pad -->
            <Border Background="#121214" CornerRadius="6" Padding="10" HorizontalAlignment="Center">
                <Grid RowDefinitions="36, 36, 36" ColumnDefinitions="36, 36, 36">
                    <!-- Up-Left -->
                    <Button x:Name="BtnPtzUpLeft" Content="↖" Grid.Row="0" Grid.Column="0" Margin="2" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                    <!-- Up -->
                    <Button x:Name="BtnPtzUp" Content="▲" Grid.Row="0" Grid.Column="1" Margin="2" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#2563EB" Foreground="White"/>
                    <!-- Up-Right -->
                    <Button x:Name="BtnPtzUpRight" Content="↗" Grid.Row="0" Grid.Column="2" Margin="2" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>

                    <!-- Left -->
                    <Button x:Name="BtnPtzLeft" Content="◀" Grid.Row="1" Grid.Column="0" Margin="2" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#2563EB" Foreground="White"/>
                    <!-- Center Stop -->
                    <Button x:Name="BtnPtzStop" Content="■" Grid.Row="1" Grid.Column="1" Margin="2" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#7F1D1D" Foreground="White"/>
                    <!-- Right -->
                    <Button x:Name="BtnPtzRight" Content="▶" Grid.Row="1" Grid.Column="2" Margin="2" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#2563EB" Foreground="White"/>

                    <!-- Down-Left -->
                    <Button x:Name="BtnPtzDownLeft" Content="↙" Grid.Row="2" Grid.Column="0" Margin="2" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                    <!-- Down -->
                    <Button x:Name="BtnPtzDown" Content="▼" Grid.Row="2" Grid.Column="1" Margin="2" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#2563EB" Foreground="White"/>
                    <!-- Down-Right -->
                    <Button x:Name="BtnPtzDownRight" Content="↘" Grid.Row="2" Grid.Column="2" Margin="2" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Zoom & Focus Controls -->
            <Grid ColumnDefinitions="*, *" Margin="0,4,0,0">
                <!-- Zoom In/Out -->
                <StackPanel Grid.Column="0" Margin="0,0,6,0" Spacing="4">
                    <TextBlock Text="Zoom" FontSize="11" Foreground="#A1A1AA" HorizontalAlignment="Center"/>
                    <Grid ColumnDefinitions="*, *">
                        <Button x:Name="BtnZoomOut" Content="➖" Grid.Column="0" Margin="0,0,2,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                        <Button x:Name="BtnZoomIn" Content="➕" Grid.Column="1" Margin="2,0,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#2563EB" Foreground="White"/>
                    </Grid>
                </StackPanel>

                <!-- Focus -->
                <StackPanel Grid.Column="1" Margin="6,0,0,0" Spacing="4">
                    <TextBlock Text="Focus" FontSize="11" Foreground="#A1A1AA" HorizontalAlignment="Center"/>
                    <Grid ColumnDefinitions="*, *">
                        <Button x:Name="BtnFocusNear" Content="Near" Grid.Column="0" Margin="0,0,2,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="10" Padding="0"/>
                        <Button x:Name="BtnFocusFar" Content="Far" Grid.Column="1" Margin="2,0,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="10" Padding="0"/>
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- Speed Slider -->
            <StackPanel Spacing="2">
                <Grid ColumnDefinitions="*, Auto">
                    <TextBlock Text="Speed" FontSize="11" Foreground="#A1A1AA"/>
                    <TextBlock x:Name="TxtSpeedVal" Grid.Column="1" Text="0.5" FontSize="11" Foreground="#3B82F6"/>
                </Grid>
                <Slider x:Name="SliderSpeed" Minimum="0.1" Maximum="1.0" Value="0.5" SmallChange="0.1"/>
            </StackPanel>

            <!-- Presets Section -->
            <Border Background="#121214" CornerRadius="4" Padding="8" Margin="0,4,0,0">
                <StackPanel Spacing="6">
                    <TextBlock Text="PRESET POINTS" FontWeight="SemiBold" FontSize="11" Foreground="#71717A"/>
                    <Grid ColumnDefinitions="*, Auto, Auto">
                        <NumericUpDown x:Name="NumPreset" Value="1" Minimum="1" Maximum="255" Margin="0,0,6,0" Height="26"/>
                        <Button x:Name="BtnCallPreset" Content="Call" Grid.Column="1" Background="#2563EB" Foreground="White" Padding="8,4" FontSize="11" Margin="0,0,4,0"/>
                        <Button x:Name="BtnSetPreset" Content="Set" Grid.Column="2" Background="#059669" Foreground="White" Padding="8,4" FontSize="11"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
