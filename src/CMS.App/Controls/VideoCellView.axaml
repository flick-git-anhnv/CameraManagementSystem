<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:kz="using:Kztek.Cameras"
             x:Class="CMS.App.Controls.VideoCellView">

    <Border x:Name="CellBorder" Background="{DynamicResource ThemeVideoAreaBackgroundBrush}" BorderBrush="{DynamicResource ThemeCardBorderBrush}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
        <Grid>
            <!-- 1. Video Player Surface -->
            <kz:AnvPlayer x:Name="Player" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

            <!-- 2. Placeholder when No Video is Playing -->
            <Grid x:Name="PlaceholderGrid" Background="{DynamicResource ThemeVideoCellPlaceholderBrush}" IsVisible="True">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                    <TextBlock Text="📹" FontSize="36" HorizontalAlignment="Center" Opacity="0.4"/>
                    <TextBlock x:Name="TxtPlaceholder" Text="Chưa có luồng video" Foreground="{DynamicResource ThemeTextSecondaryBrush}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Nhấn đúp camera trong danh sách để phát" Foreground="{DynamicResource ThemeTextMutedBrush}" Opacity="0.8" FontSize="11" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- 3. Top OSD Overlay -->
            <Border VerticalAlignment="Top" Background="#A013111C" Padding="8,4" Margin="6" CornerRadius="6">
                <Grid ColumnDefinitions="Auto, *, Auto">
                    <!-- Status, Camera Name & Badges -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Border x:Name="StatusDot" Background="#EF4444" CornerRadius="4" Width="8" Height="8" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtCameraName" Text="Ô camera trống" FontWeight="SemiBold" FontSize="12" Foreground="White" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        
                        <!-- Stream Resolution Badge -->
                        <Border x:Name="StreamBadge" Background="#4A3F8C" CornerRadius="3" Padding="5,2" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtStreamType" Text="PHỤ" FontSize="9" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Recording Indicator Badge -->
                        <Border x:Name="RecBadge" Background="#DC2626" CornerRadius="3" Padding="5,2" VerticalAlignment="Center" IsVisible="False">
                            <TextBlock Text="● GHI" FontSize="9" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <!-- Top Action Buttons (Icons & Text Mathematically Centered) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <!-- Record Button -->
                        <Button x:Name="BtnRecord" Width="26" Height="24" Padding="0"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Background="#342F50" Foreground="White" CornerRadius="4" Cursor="Hand"
                                ToolTip.Tip="Bật / Dừng ghi hình (Zero-Transcode)">
                            <Ellipse x:Name="RecordIconDot" Width="8" Height="8" Fill="#EF4444"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>

                        <!-- Stream Toggle Button -->
                        <Button x:Name="BtnToggleStream" Width="28" Height="24" Padding="0"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Background="#342F50" Foreground="White" CornerRadius="4" Cursor="Hand"
                                ToolTip.Tip="Chuyển đổi luồng Chính (HD) / Phụ (SD)">
                            <TextBlock Text="HD" FontSize="10" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                        </Button>

                        <!-- Snapshot Button -->
                        <Button x:Name="BtnSnapshot" Width="26" Height="24" Padding="0"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Background="#342F50" Foreground="White" CornerRadius="4" Cursor="Hand"
                                ToolTip.Tip="Chụp ảnh khung hình hiện tại">
                            <PathIcon Data="M4 4h3l1.5-2h7L17 4h3c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2zm8 14c3.31 0 6-2.69 6-6s-2.69-6-6-6-6 2.69-6 6 2.69 6 6 6zm0-2c-2.21 0-4-1.79-4-4s1.79-4 4-4 4 1.79 4 4-1.79 4-4 4z"
                                      Width="12" Height="11" Foreground="White"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>

                        <!-- Close Button -->
                        <Button x:Name="BtnClose" Width="26" Height="24" Padding="0"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Background="#DC2626" Foreground="White" CornerRadius="4" Cursor="Hand"
                                ToolTip.Tip="Đóng luồng camera">
                            <PathIcon Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                                      Width="10" Height="10" Foreground="White"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
