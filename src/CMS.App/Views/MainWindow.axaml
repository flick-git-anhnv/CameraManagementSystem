<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CMS.App.ViewModels"
        x:Class="CMS.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="1280" Height="800"
        WindowStartupLocation="CenterScreen">

    <Grid RowDefinitions="Auto, *, Auto">
        <!-- Top Menu Bar -->
        <Border Grid.Row="0" Background="#1E1E1E" Padding="12,8" BorderBrush="#333333" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="KZTEK VMS" FontWeight="Bold" FontSize="16" Foreground="#3B82F6" VerticalAlignment="Center"/>
                    <TextBlock Text="•" Foreground="#666666" VerticalAlignment="Center"/>
                    <TextBlock Text="Camera Management System" FontSize="14" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Navigation Tabs -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <Button Content="📺 Live View" Background="#2563EB" Foreground="White" Padding="14,6" CornerRadius="4"/>
                    <Button Content="⏪ Playback" Background="#2D2D2D" Foreground="#CCCCCC" Padding="14,6" CornerRadius="4"/>
                    <Button Content="🤖 AI Analytics" Background="#2D2D2D" Foreground="#CCCCCC" Padding="14,6" CornerRadius="4"/>
                    <Button Content="🗺️ E-Map" Background="#2D2D2D" Foreground="#CCCCCC" Padding="14,6" CornerRadius="4"/>
                    <Button Content="⚙️ Device Management" Background="#2D2D2D" Foreground="#CCCCCC" Padding="14,6" CornerRadius="4"/>
                </StackPanel>

                <!-- User & Settings -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="👤 Admin" Foreground="#A0A0A0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Workspace -->
        <Grid Grid.Row="1" ColumnDefinitions="280, *">
            <!-- Left Sidebar (Device Tree) -->
            <Border Grid.Column="0" Background="#252526" BorderBrush="#333333" BorderThickness="0,0,1,0" Padding="8">
                <Grid RowDefinitions="Auto, Auto, *">
                    <TextBlock Grid.Row="0" Text="DEVICE LIST" FontWeight="SemiBold" FontSize="12" Foreground="#888888" Margin="4,4,4,8"/>
                    <TextBox Grid.Row="1" PlaceholderText="Search camera (IP/Name)..." Margin="0,0,0,8"/>
                    
                    <ScrollViewer Grid.Row="2">
                        <StackPanel Spacing="4">
                            <TextBlock Text="📁 All Cameras (0)" Foreground="#CCCCCC" Margin="4,4,0,4"/>
                            <TextBlock Text="   (Scan or Add camera to start)" Foreground="#777777" FontSize="12" Margin="12,0,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Video Grid Area -->
            <Grid Grid.Column="1" Background="#141414">
                <Border Margin="12" Background="#1A1A1A" CornerRadius="6" BorderBrush="#2A2A2A" BorderThickness="1">
                    <Grid RowDefinitions="*, Auto">
                        <!-- Grid Placeholder -->
                        <Grid Grid.Row="0">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                                <TextBlock Text="📹" FontSize="48" HorizontalAlignment="Center"/>
                                <TextBlock Text="Live View Grid Ready" FontSize="18" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                <TextBlock Text="Ready to connect multi-brand cameras (Hikvision, Dahua, ONVIF, RTSP)" Foreground="#888888" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- Bottom Grid Control Bar -->
                        <Border Grid.Row="1" Background="#1F1F1F" Padding="12,8" BorderBrush="#2A2A2A" BorderThickness="0,1,0,0">
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                    <Button Content="[ 1 ]" Width="36" Height="28"/>
                                    <Button Content="[ 4 ]" Width="36" Height="28"/>
                                    <Button Content="[ 9 ]" Width="36" Height="28"/>
                                    <Button Content="[ 16 ]" Width="40" Height="28"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                    <Button Content="⛶ Fullscreen" Height="28"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="2" Background="#007ACC" Padding="12,3">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <TextBlock Grid.Column="0" Text="{Binding SystemStatus}" Foreground="White" FontSize="12"/>
                <TextBlock Grid.Column="2" Text="KZTEK CMS Core v1.0.0" Foreground="White" FontSize="12"/>
            </Grid>
        </Border>
    </Grid>
</Window>
