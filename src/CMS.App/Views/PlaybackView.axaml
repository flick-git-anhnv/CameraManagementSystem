<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CMS.App.ViewModels"
             xmlns:controls="using:CMS.App.Controls"
             xmlns:entities="using:CMS.Core.Entities"
             xmlns:kz="clr-namespace:KztekComponentAvalonia.Controls;assembly=KztekComponentAvalonia"
             x:Class="CMS.App.Views.PlaybackView"
             x:DataType="vm:PlaybackViewModel">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="310" MinWidth="240" MaxWidth="500"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="*" MinWidth="400"/>
        </Grid.ColumnDefinitions>

        <!-- ── 1. Left Sidebar: Camera List & Date Selector ───────────────── -->
        <Border Grid.Column="0" Background="{DynamicResource ThemeCardBackgroundBrush}" BorderBrush="{DynamicResource ThemeCardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
            <Grid RowDefinitions="Auto, Auto, Auto, Auto, *">
                <TextBlock Grid.Row="0" Text="TRA CỨU BẢN GHI LƯU TRỮ" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource ThemeBrandBrush}" Margin="0,0,0,12"/>

                <!-- Camera Selector -->
                <TextBlock Grid.Row="1" Text="Chọn Camera giám sát:" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,4"/>
                <ComboBox Grid.Row="2" ItemsSource="{Binding Cameras}" SelectedItem="{Binding SelectedCamera}" HorizontalAlignment="Stretch" Margin="0,0,0,12">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="entities:CameraDevice">
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- Date Picker & Search Button -->
                <StackPanel Grid.Row="3" Spacing="8" Margin="0,0,0,12">
                    <TextBlock Text="Chọn Ngày ghi hình:" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                    <DatePicker SelectedDate="{Binding SelectedDate}" HorizontalAlignment="Stretch"/>
                    <kz:KzButton Content="🔍 Tra cứu bản ghi" 
                                 Command="{Binding SearchRecordingsCommand}"
                                 Variant="Primary" KzSize="Md"
                                 HorizontalAlignment="Stretch"/>
                </StackPanel>

                <!-- Record Segments List -->
                <Border Grid.Row="4" Background="{DynamicResource ThemeCardSecondaryBackgroundBrush}" CornerRadius="6" BorderBrush="{DynamicResource ThemeCardBorderBrush}" BorderThickness="1" Padding="10">
                    <Grid RowDefinitions="Auto, *">
                        <TextBlock Grid.Row="0" Text="DANH SÁCH ĐOẠN VIDEO" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource ThemeTextMutedBrush}" Margin="0,0,0,8"/>
                        <ListBox Grid.Row="1" ItemsSource="{Binding AvailableSegments}" SelectedItem="{Binding CurrentPlayingSegment}" Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="entities:VideoSegment">
                                    <Border Background="{DynamicResource ThemeItemContainerBackgroundBrush}" BorderBrush="{DynamicResource ThemeItemContainerBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,2">
                                        <Grid ColumnDefinitions="Auto, *">
                                            <Border Grid.Column="0" Background="#10B981" CornerRadius="3" Width="4" Margin="0,0,8,0"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding StartTime, StringFormat='{}{0:HH:mm:ss} - '}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding EndTime, StringFormat='{}{0:HH:mm:ss}'}" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding DurationSeconds, StringFormat='Thời lượng: {0:F0} giây'}" FontSize="10" Foreground="{DynamicResource ThemeTextMutedBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Vertical Splitter -->
        <GridSplitter Grid.Column="1" Width="6" ResizeDirection="Columns" HorizontalAlignment="Center" VerticalAlignment="Stretch" Margin="1,0"/>

        <!-- ── 2. Right: Video Surface & Timeline ────────────────────────── -->
        <Grid Grid.Column="2" RowDefinitions="*, Auto, Auto">
            <!-- Video Display Area -->
            <Border Grid.Row="0" Background="{DynamicResource ThemeVideoAreaBackgroundBrush}" BorderBrush="{DynamicResource ThemeCardBorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,8">
                <Grid>
                    <!-- Screen Surface Placeholder / Player -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                        <TextBlock Text="🎬" FontSize="56" HorizontalAlignment="Center" Opacity="0.5"/>
                        <TextBlock Text="Đầu phát Video đồng bộ sẵn sàng" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding PlaybackStatus}" Foreground="{DynamicResource ThemeTextSecondaryBrush}" FontSize="12" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Top OSD Information -->
                    <Border VerticalAlignment="Top" HorizontalAlignment="Left" Background="#A013111C" Padding="12,6" Margin="10" CornerRadius="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding SelectedCamera.Name, FallbackValue='Chưa chọn Camera'}" FontWeight="Bold" Foreground="White" FontSize="13"/>
                            <TextBlock Text="•" Foreground="#8E88B0"/>
                            <TextBlock Text="{Binding SelectedDate, StringFormat='{}{0:dd/MM/yyyy}'}" Foreground="#F8FAFC" FontSize="13"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Playback Control Toolbar -->
            <Border Grid.Row="1" Background="{DynamicResource ThemeCardBackgroundBrush}" BorderBrush="{DynamicResource ThemeCardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                <Grid ColumnDefinitions="Auto, *, Auto">
                    <!-- Playback Controls -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                        <kz:KzButton Content="⏮️ -10s" Variant="Secondary" KzSize="Sm" ToolTip.Tip="Lùi lại 10 giây"/>
                        <kz:KzButton Content="◀️ Chậm" Variant="Secondary" KzSize="Sm" ToolTip.Tip="Phát chậm"/>
                        <kz:KzButton Content="▶️ Phát / Dừng" 
                                     Command="{Binding TogglePlayPauseCommand}"
                                     Variant="Primary" KzSize="Sm" ToolTip.Tip="Phát hoặc tạm dừng video"/>
                        <kz:KzButton Content="Nhanh ▶️" Variant="Secondary" KzSize="Sm" ToolTip.Tip="Tua nhanh"/>
                        <kz:KzButton Content="+10s ⏭️" Variant="Secondary" KzSize="Sm" ToolTip.Tip="Tiến tới 10 giây"/>
                    </StackPanel>

                    <!-- Speed & Format Badges -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <kz:KzBadge Variant="Info" BadgeType="Tag" Content="{Binding SpeedLabel, StringFormat='Tốc độ: {0}'}"/>
                        <kz:KzBadge Variant="Accent" BadgeType="Tag" Content="MP4 Không giải mã lại (Zero-Transcode)"/>
                    </StackPanel>

                    <!-- Export Tools -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                        <kz:KzButton Content="📸 Chụp ảnh" Variant="Secondary" KzSize="Sm" ToolTip.Tip="Chụp khung hình xem lại"/>
                        <kz:KzButton Content="✂️ Xuất video" Variant="Primary" KzSize="Sm" ToolTip.Tip="Xuất đoạn video lưu về máy"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 24-Hour Timeline Control -->
            <Border Grid.Row="2" Background="{DynamicResource ThemeCardBackgroundBrush}" BorderBrush="{DynamicResource ThemeCardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                <Grid RowDefinitions="Auto, Auto">
                    <!-- Timeline Header & Legend -->
                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="4,0,4,8">
                        <TextBlock Grid.Column="0" Text="DÒNG THỜI GIAN ĐỒNG BỘ 24 GIỜ" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource ThemeTextMutedBrush}" VerticalAlignment="Center"/>
                        
                        <!-- Legend -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Border Background="#10B981" Width="10" Height="10" CornerRadius="2"/>
                                <TextBlock Text="Ghi liên tục (24/7)" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Border Background="#F59E0B" Width="10" Height="10" CornerRadius="2"/>
                                <TextBlock Text="Sự kiện chuyển động" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Border Background="#EF4444" Width="10" Height="10" CornerRadius="2"/>
                                <TextBlock Text="Sự kiện AI" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Timeline Surface -->
                    <controls:TimelineControl x:Name="Timeline" Grid.Row="1"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
