<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CMS.App.ViewModels"
             xmlns:controls="using:CMS.App.Controls"
             xmlns:entities="using:CMS.Core.Entities"
             xmlns:kz="clr-namespace:KztekComponentAvalonia.Controls;assembly=KztekComponentAvalonia"
             x:Class="CMS.App.Views.EMapView"
             x:DataType="vm:EMapViewModel">

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" MinWidth="240" MaxWidth="500"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="*" MinWidth="400"/>
        </Grid.ColumnDefinitions>

        <!-- ── 1. Left Sidebar: Cameras list ──────────────────────────────── -->
        <Border Grid.Column="0" Background="{DynamicResource ThemeCardBackgroundBrush}" BorderBrush="{DynamicResource ThemeCardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
            <Grid RowDefinitions="Auto, Auto, *, Auto">
                <TextBlock Grid.Row="0" Text="BỐ TRÍ CAMERA TRÊN BẢN ĐỒ" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource ThemeBrandBrush}" Margin="0,0,0,6"/>
                <TextBlock Grid.Row="1" Text="Chọn camera rồi nhấp lên bản đồ để đặt/đổi vị trí, hoặc kéo thả trực tiếp biểu tượng camera trên bản đồ." FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                <ListBox Grid.Row="2" ItemsSource="{Binding AvailableCameras}" SelectedItem="{Binding SelectedCamera}" Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="entities:CameraDevice">
                            <Border Background="{DynamicResource ThemeItemContainerBackgroundBrush}" BorderBrush="{DynamicResource ThemeItemContainerBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,3">
                                <Grid ColumnDefinitions="Auto, *, Auto">
                                    <TextBlock Grid.Column="0" Text="📹" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding IpAddress}" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                    </StackPanel>
                                    <kz:KzButton Grid.Column="2" Content="🗑️"
                                                 Command="{Binding $parent[UserControl].((vm:EMapViewModel)DataContext).RemoveCameraFromMapCommand}"
                                                 CommandParameter="{Binding}"
                                                 Variant="Danger" KzSize="Sm"
                                                 ToolTip.Tip="Xóa camera này khỏi sơ đồ mặt bằng"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Status Banner -->
                <Border Grid.Row="3" Background="{DynamicResource ThemeCardSecondaryBackgroundBrush}" BorderBrush="{DynamicResource ThemeCardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,12,0,0">
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                </Border>
            </Grid>
        </Border>

        <!-- Vertical Splitter -->
        <GridSplitter x:Name="SplitterEMap" Grid.Column="1" Width="6" ResizeDirection="Columns" HorizontalAlignment="Center" VerticalAlignment="Stretch" Margin="1,0"/>

        <!-- ── 2. Right: Interactive Floor Plan Canvas ───────────────────── -->
        <Border Grid.Column="2" Background="{DynamicResource ThemeCardBackgroundBrush}" BorderBrush="{DynamicResource ThemeCardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
            <Grid RowDefinitions="Auto, *">
                <!-- Map Header -->
                <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="4,0,4,10">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="🗺️" FontSize="18" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding MapTitle}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <kz:KzButton x:Name="BtnLoadMapImage" Content="📂 Tải sơ đồ mặt bằng" Variant="Secondary" KzSize="Sm" ToolTip.Tip="Tải ảnh mặt bằng từ máy tính"/>
                        <kz:KzButton Content="🔄 Đặt lại vị trí" Command="{Binding ResetDefaultPositionsCommand}" Variant="Secondary" KzSize="Sm" ToolTip.Tip="Khôi phục vị trí camera mẫu mặc định"/>
                        <kz:KzButton Content="🗑️ Xóa tất cả" Command="{Binding ClearAllNodesCommand}" Variant="Danger" KzSize="Sm" ToolTip.Tip="Xóa toàn bộ camera trên bản đồ"/>
                        <kz:KzButton Content="💾 Lưu cấu hình" Command="{Binding SaveConfigCommand}" Variant="Primary" KzSize="Sm" ToolTip.Tip="Lưu lại cấu hình sơ đồ mặt bằng và vị trí camera vào cơ sở dữ liệu"/>
                    </StackPanel>
                </Grid>

                <!-- Blueprint Floor Plan Container -->
                <Border Grid.Row="1" Background="#0C0B14" BorderBrush="{DynamicResource ThemeCardBorderBrush}" BorderThickness="2" CornerRadius="8" ClipToBounds="True">
                    <Grid>
                        <!-- Custom Floor Plan Image (if loaded by user) -->
                        <Image x:Name="CustomMapImage" Stretch="Fill" IsVisible="False"/>

                        <!-- Grid Floor Blueprint Lines -->
                        <Canvas x:Name="MapCanvas" Background="#0D0B17" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <!-- Background Blueprint Rooms -->
                            <Rectangle Canvas.Left="40" Canvas.Top="40" Width="300" Height="230" Stroke="#4A3F8C" StrokeThickness="2" StrokeDashArray="4,2" Fill="#124A3F8C"/>
                            <TextBlock Canvas.Left="50" Canvas.Top="50" Text="TÒA NHÀ A — SẢNH ĐÓN TIẾP &amp; LỄ TÂN" FontSize="11" Foreground="#F05922" FontWeight="SemiBold"/>

                            <Rectangle Canvas.Left="380" Canvas.Top="40" Width="400" Height="230" Stroke="#4A3F8C" StrokeThickness="2" StrokeDashArray="4,2" Fill="#124A3F8C"/>
                            <TextBlock Canvas.Left="390" Canvas.Top="50" Text="KHU VỰC B — BÃI ĐỖ XE &amp; CỔNG AN NINH" FontSize="11" Foreground="#F05922" FontWeight="SemiBold"/>

                            <Rectangle Canvas.Left="40" Canvas.Top="310" Width="740" Height="220" Stroke="#4A3F8C" StrokeThickness="2" StrokeDashArray="4,2" Fill="#124A3F8C"/>
                            <TextBlock Canvas.Left="50" Canvas.Top="320" Text="KHU VỰC C — VÀNH ĐAI CHU VI &amp; KHO HÀNG" FontSize="11" Foreground="#F05922" FontWeight="SemiBold"/>
                        </Canvas>

                        <!-- Floating Live Preview Popup (when camera clicked on map) -->
                        <Border x:Name="PopupPreview" Width="320" Height="230" Background="{DynamicResource ThemeCardBackgroundBrush}" BorderBrush="{DynamicResource ThemeBrandBrush}" BorderThickness="1" CornerRadius="8" 
                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16" IsVisible="False" BoxShadow="0 4 20 #80000000">
                            <Grid RowDefinitions="Auto, *">
                                <Border Grid.Row="0" Background="#F05922" Padding="10,6" CornerRadius="7,7,0,0">
                                    <Grid ColumnDefinitions="*, Auto, Auto">
                                        <TextBlock x:Name="TxtPopupTitle" Text="Xem trực tiếp camera" FontWeight="Bold" FontSize="11" Foreground="White" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <Button x:Name="BtnRemoveFromPopup" Content="🗑️ Gỡ" Grid.Column="1" Background="#33000000" Foreground="White" Padding="6,2" Margin="4,0" FontSize="11" Cursor="Hand" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="Xóa camera này khỏi bản đồ"/>
                                        <Button x:Name="BtnClosePopup" Content="✕" Grid.Column="2" Width="24" Height="22" Padding="0" Background="Transparent" Foreground="White" FontSize="12" Cursor="Hand" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="Đóng cửa sổ xem trước"/>
                                    </Grid>
                                </Border>
                                <controls:VideoCellView x:Name="PopupPlayer" Grid.Row="1"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
