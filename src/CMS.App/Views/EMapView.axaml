<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CMS.App.ViewModels"
             xmlns:controls="using:CMS.App.Controls"
             xmlns:entities="using:CMS.Core.Entities"
             xmlns:kz="clr-namespace:KztekComponentAvalonia.Controls;assembly=KztekComponentAvalonia"
             x:Class="CMS.App.Views.EMapView"
             x:DataType="vm:EMapViewModel">

    <Grid ColumnDefinitions="300, *" Margin="12">
        <!-- ── 1. Left Sidebar: Cameras list ──────────────────────────────── -->
        <Border Grid.Column="0" Background="{DynamicResource ThemeCardBackgroundBrush}" BorderBrush="{DynamicResource ThemeCardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,10,0">
            <Grid RowDefinitions="Auto, Auto, *, Auto">
                <TextBlock Grid.Row="0" Text="BỐ TRÍ CAMERA TRÊN BẢN ĐỒ" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource ThemeBrandBrush}" Margin="0,0,0,6"/>
                <TextBlock Grid.Row="1" Text="Chọn camera bên dưới, sau đó nhấp vào vị trí bất kỳ trên sơ đồ mặt bằng để gán tọa độ." FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                <ListBox Grid.Row="2" ItemsSource="{Binding AvailableCameras}" SelectedItem="{Binding SelectedCamera}" Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="entities:CameraDevice">
                            <Border Background="{DynamicResource ThemeItemContainerBackgroundBrush}" BorderBrush="{DynamicResource ThemeItemContainerBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,3">
                                <Grid ColumnDefinitions="Auto, *">
                                    <TextBlock Grid.Column="0" Text="📹" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontSize="12"/>
                                        <TextBlock Text="{Binding IpAddress}" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Status Banner -->
                <Border Grid.Row="3" Background="{DynamicResource ThemeCardSecondaryBackgroundBrush}" BorderBrush="{DynamicResource ThemeCardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,12,0,0">
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                </Border>
            </Grid>
        </Border>

        <!-- ── 2. Right: Interactive Floor Plan Canvas ───────────────────── -->
        <Border Grid.Column="1" Background="{DynamicResource ThemeCardBackgroundBrush}" BorderBrush="{DynamicResource ThemeCardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
            <Grid RowDefinitions="Auto, *">
                <!-- Map Header -->
                <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="4,0,4,10">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="🗺️" FontSize="18" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding MapTitle}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <kz:KzButton Content="📂 Tải sơ đồ mặt bằng" Variant="Secondary" KzSize="Sm"/>
                        <kz:KzButton Content="🔄 Đặt lại vị trí" Variant="Secondary" KzSize="Sm"/>
                    </StackPanel>
                </Grid>

                <!-- Blueprint Floor Plan Container -->
                <Border Grid.Row="1" Background="#0C0B14" BorderBrush="{DynamicResource ThemeCardBorderBrush}" BorderThickness="2" CornerRadius="8" ClipToBounds="True">
                    <Grid>
                        <!-- Grid Floor Blueprint Lines -->
                        <Canvas x:Name="MapCanvas" Background="#0D0B17" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <!-- Background Blueprint Rooms -->
                            <Rectangle Canvas.Left="40" Canvas.Top="40" Width="300" Height="230" Stroke="#4A3F8C" StrokeThickness="2" StrokeDashArray="4,2" Fill="#124A3F8C"/>
                            <TextBlock Canvas.Left="50" Canvas.Top="50" Text="TÒA NHÀ A — SẢNH ĐÓN TIẾP &amp; LỄ TÂN" FontSize="11" Foreground="#F05922" FontWeight="SemiBold"/>

                            <Rectangle Canvas.Left="380" Canvas.Top="40" Width="400" Height="230" Stroke="#4A3F8C" StrokeThickness="2" StrokeDashArray="4,2" Fill="#124A3F8C"/>
                            <TextBlock Canvas.Left="390" Canvas.Top="50" Text="KHU VỰC B — BÃI ĐỖ XE &amp; CỔNG AN NINH" FontSize="11" Foreground="#F05922" FontWeight="SemiBold"/>

                            <Rectangle Canvas.Left="40" Canvas.Top="310" Width="740" Height="220" Stroke="#4A3F8C" StrokeThickness="2" StrokeDashArray="4,2" Fill="#124A3F8C"/>
                            <TextBlock Canvas.Left="50" Canvas.Top="320" Text="KHU VỰC C — VÀNH ĐAI CHU VI &amp; KHO HÀNG" FontSize="11" Foreground="#F05922" FontWeight="SemiBold"/>
                        </Canvas>

                        <!-- Floating Live Preview Popup (when camera clicked on map) -->
                        <Border x:Name="PopupPreview" Width="320" Height="230" Background="{DynamicResource ThemeCardBackgroundBrush}" BorderBrush="{DynamicResource ThemeBrandBrush}" BorderThickness="1" CornerRadius="8" 
                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16" IsVisible="False" BoxShadow="0 4 20 #80000000">
                            <Grid RowDefinitions="Auto, *">
                                <Border Grid.Row="0" Background="#F05922" Padding="10,6" CornerRadius="7,7,0,0">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <TextBlock x:Name="TxtPopupTitle" Text="Xem trực tiếp camera" FontWeight="Bold" FontSize="11" Foreground="White" VerticalAlignment="Center"/>
                                        <Button x:Name="BtnClosePopup" Content="✕" Grid.Column="1" Background="Transparent" Foreground="White" Padding="6,2" FontSize="11" Cursor="Hand"/>
                                    </Grid>
                                </Border>
                                <controls:VideoCellView x:Name="PopupPlayer" Grid.Row="1"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
