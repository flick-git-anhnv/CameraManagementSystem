<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CMS.App.ViewModels"
             xmlns:controls="using:CMS.App.Controls"
             xmlns:entities="using:CMS.Core.Entities"
             x:Class="CMS.App.Views.EMapView"
             x:DataType="vm:EMapViewModel">

    <Grid ColumnDefinitions="280, *" Margin="8">
        <!-- 1. Left Sidebar: Cameras list -->
        <Border Grid.Column="0" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,8,0">
            <Grid RowDefinitions="Auto, Auto, *, Auto">
                <TextBlock Grid.Row="0" Text="E-MAP CAMERA PLACEMENT" FontWeight="Bold" FontSize="13" Foreground="#3B82F6" Margin="0,0,0,8"/>
                <TextBlock Grid.Row="1" Text="Select camera below, then click anywhere on the floor plan to position it." FontSize="11" Foreground="#A1A1AA" TextWrapping="Wrap" Margin="0,0,0,10"/>

                <ListBox Grid.Row="2" ItemsSource="{Binding AvailableCameras}" SelectedItem="{Binding SelectedCamera}" Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="entities:CameraDevice">
                            <Border Background="#222225" CornerRadius="4" Padding="10,8" Margin="0,2">
                                <Grid ColumnDefinitions="Auto, *">
                                    <TextBlock Grid.Column="0" Text="📹" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="White" FontSize="12"/>
                                        <TextBlock Text="{Binding IpAddress}" FontSize="10" Foreground="#71717A"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Status Banner -->
                <Border Grid.Row="3" Background="#222225" CornerRadius="4" Padding="8" Margin="0,10,0,0">
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="11" Foreground="#E4E4E7"/>
                </Border>
            </Grid>
        </Border>

        <!-- 2. Right: Interactive Floor Plan Canvas -->
        <Border Grid.Column="1" Background="#09090B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="6" Padding="12">
            <Grid RowDefinitions="Auto, *">
                <!-- Map Header -->
                <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="4,0,4,8">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="🗺️" FontSize="16" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding MapTitle}" FontWeight="Bold" FontSize="14" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                        <Button Content="📂 Load Floor Plan" Padding="10,4" FontSize="11" Background="#27272A"/>
                        <Button Content="🔄 Reset Nodes" Padding="10,4" FontSize="11" Background="#27272A"/>
                    </StackPanel>
                </Grid>

                <!-- Blueprint Floor Plan Container -->
                <Border Grid.Row="1" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="2" CornerRadius="6" ClipToBounds="True">
                    <Grid>
                        <!-- Grid Floor Blueprint Lines -->
                        <Canvas x:Name="MapCanvas" Background="#0A0F1D" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <!-- Background Blueprint Rooms -->
                            <Rectangle Canvas.Left="40" Canvas.Top="40" Width="280" Height="220" Stroke="#1E3A8A" StrokeThickness="2" StrokeDashArray="4,2" Fill="#051E3A8A"/>
                            <TextBlock Canvas.Left="50" Canvas.Top="50" Text="BUILDING A - RECEPTION &amp; LOBBY" FontSize="11" Foreground="#3B82F6" FontWeight="SemiBold"/>

                            <Rectangle Canvas.Left="360" Canvas.Top="40" Width="380" Height="220" Stroke="#1E3A8A" StrokeThickness="2" StrokeDashArray="4,2" Fill="#051E3A8A"/>
                            <TextBlock Canvas.Left="370" Canvas.Top="50" Text="ZONE B - VEHICLE PARKING &amp; ACCESS GATE" FontSize="11" Foreground="#3B82F6" FontWeight="SemiBold"/>

                            <Rectangle Canvas.Left="40" Canvas.Top="300" Width="700" Height="200" Stroke="#1E3A8A" StrokeThickness="2" StrokeDashArray="4,2" Fill="#051E3A8A"/>
                            <TextBlock Canvas.Left="50" Canvas.Top="310" Text="ZONE C - MAIN PERIMETER &amp; WAREHOUSE" FontSize="11" Foreground="#3B82F6" FontWeight="SemiBold"/>
                        </Canvas>

                        <!-- Floating Live Preview Popup (when camera clicked on map) -->
                        <Border x:Name="PopupPreview" Width="280" Height="200" Background="#18181B" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="6" 
                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16" IsVisible="False" BoxShadow="0 4 20 #80000000">
                            <Grid RowDefinitions="Auto, *">
                                <Border Grid.Row="0" Background="#2563EB" Padding="8,4" CornerRadius="5,5,0,0">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <TextBlock x:Name="TxtPopupTitle" Text="Camera Preview" FontWeight="Bold" FontSize="11" Foreground="White"/>
                                        <Button x:Name="BtnClosePopup" Content="✕" Grid.Column="1" Background="Transparent" Foreground="White" Padding="4,0" FontSize="10"/>
                                    </Grid>
                                </Border>
                                <controls:VideoCellView x:Name="PopupPlayer" Grid.Row="1"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
