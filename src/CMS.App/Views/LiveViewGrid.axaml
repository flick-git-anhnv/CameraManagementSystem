<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:CMS.App.Controls"
             xmlns:kz="clr-namespace:KztekComponentAvalonia.Controls;assembly=KztekComponentAvalonia"
             x:Class="CMS.App.Views.LiveViewGrid">

    <Grid RowDefinitions="*, Auto">
        <!-- 1. Dynamic Video Cells Grid Container -->
        <Grid x:Name="VideoGridContainer" Grid.Row="0" Margin="4"/>

        <!-- 2. Bottom Toolbar for Grid Switching -->
        <Border Grid.Row="1" Background="{DynamicResource ThemeNavBackgroundBrush}" Padding="12,8" BorderBrush="{DynamicResource ThemeNavBorderBrush}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*, Auto">
                <!-- Left: Presets & Custom Rows x Columns -->
                <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <!-- Label -->
                        <TextBlock Text="Bố cục lưới:" Foreground="{DynamicResource ThemeTextSecondaryBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0"/>

                        <!-- Preset Buttons -->
                        <kz:KzButton x:Name="BtnGrid1x1" Content="1×1" Variant="Secondary" KzSize="Sm" MinWidth="44" ToolTip.Tip="Lưới 1×1 (1 ô toàn màn hình)"/>
                        <kz:KzButton x:Name="BtnGrid2x2" Content="2×2" Variant="Primary" KzSize="Sm" MinWidth="44" ToolTip.Tip="Lưới 2×2 (4 ô chuẩn)"/>
                        <kz:KzButton x:Name="BtnGrid3x3" Content="3×3" Variant="Secondary" KzSize="Sm" MinWidth="44" ToolTip.Tip="Lưới 3×3 (9 ô)"/>
                        <kz:KzButton x:Name="BtnGrid4x4" Content="4×4" Variant="Secondary" KzSize="Sm" MinWidth="44" ToolTip.Tip="Lưới 4×4 (16 ô)"/>
                        <kz:KzButton x:Name="BtnGrid2x3" Content="2×3" Variant="Secondary" KzSize="Sm" MinWidth="44" ToolTip.Tip="Lưới 2 hàng × 3 cột (6 ô)"/>
                        <kz:KzButton x:Name="BtnGrid2x4" Content="2×4" Variant="Secondary" KzSize="Sm" MinWidth="44" ToolTip.Tip="Lưới 2 hàng × 4 cột (8 ô)"/>
                        <kz:KzButton x:Name="BtnGrid3x4" Content="3×4" Variant="Secondary" KzSize="Sm" MinWidth="44" ToolTip.Tip="Lưới 3 hàng × 4 cột (12 ô)"/>

                        <!-- Vertical Separator -->
                        <Border Width="1" Height="22" Background="{DynamicResource ThemeCardBorderBrush}" Margin="6,0"/>

                        <!-- Custom Rows & Cols Picker -->
                        <TextBlock Text="Tùy chỉnh:" Foreground="{DynamicResource ThemeTextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Text="Hàng" Foreground="{DynamicResource ThemeTextMutedBrush}" FontSize="11" VerticalAlignment="Center"/>
                        <NumericUpDown x:Name="NumRows" Minimum="1" Maximum="10" Value="2" FormatString="0"
                                       Width="100" Height="30" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                       Padding="4,0" ToolTip.Tip="Số hàng (1 - 10)"/>
                        <TextBlock Text="×" Foreground="{DynamicResource ThemeTextSecondaryBrush}" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock Text="Cột" Foreground="{DynamicResource ThemeTextMutedBrush}" FontSize="11" VerticalAlignment="Center"/>
                        <NumericUpDown x:Name="NumCols" Minimum="1" Maximum="10" Value="2" FormatString="0"
                                       Width="100" Height="30" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                       Padding="4,0" ToolTip.Tip="Số cột (1 - 10)"/>
                        <kz:KzButton x:Name="BtnApplyCustomGrid" Content="Áp dụng" Variant="Secondary" KzSize="Sm"
                                     ToolTip.Tip="Áp dụng số hàng và cột tùy chỉnh"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Right: Action Buttons (100% Vietnamese) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="10,0,0,0">
                    <kz:KzButton x:Name="BtnRecordAll" Content="⏺️ Ghi tất cả" Variant="Danger" KzSize="Sm"
                                 ToolTip.Tip="Bật / Dừng ghi hình cho tất cả camera đang phát"/>
                    <kz:KzButton x:Name="BtnStopAll" Content="⏹️ Dừng tất cả" Variant="Secondary" KzSize="Sm"
                                 ToolTip.Tip="Dừng phát video trên tất cả các ô"/>
                    <kz:KzButton x:Name="BtnAutoFill" Content="▶️ Phát tất cả" Variant="Primary" KzSize="Sm"
                                 ToolTip.Tip="Tự động phát danh sách camera lên lưới"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
