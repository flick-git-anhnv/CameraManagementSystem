<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:CMS.App.Controls"
             x:Class="CMS.App.Views.LiveViewGrid">

    <Grid RowDefinitions="*, Auto">
        <!-- 1. Dynamic Video Cells Grid Container -->
        <Grid x:Name="VideoGridContainer" Grid.Row="0" Margin="4"/>

        <!-- 2. Bottom Toolbar for Grid Switching -->
        <Border Grid.Row="1" Background="#18181B" Padding="12,8" BorderBrush="#27272A" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                    <Button x:Name="BtnGrid1x1" Content="1x1" Width="42" Height="28"/>
                    <Button x:Name="BtnGrid2x2" Content="2x2" Width="42" Height="28" Background="#2563EB" Foreground="White"/>
                    <Button x:Name="BtnGrid3x3" Content="3x3" Width="42" Height="28"/>
                    <Button x:Name="BtnGrid4x4" Content="4x4" Width="42" Height="28"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="BtnStopAll" Content="⏹️ Stop All" Height="28"/>
                    <Button x:Name="BtnAutoFill" Content="▶️ Play All Registered" Height="28" Background="#059669" Foreground="White"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
