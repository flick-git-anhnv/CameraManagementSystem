<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:CMS.App.Controls"
             x:Class="CMS.App.Views.LiveViewGrid">

    <Grid RowDefinitions="*, Auto">
        <!-- 1. Dynamic Video Cells Grid Container -->
        <Grid x:Name="VideoGridContainer" Grid.Row="0" Margin="4"/>

        <!-- 2. Bottom Toolbar for Grid Switching -->
        <Border Grid.Row="1" Background="{DynamicResource ThemeNavBackgroundBrush}" Padding="10,6" BorderBrush="{DynamicResource ThemeNavBorderBrush}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*, Auto">
                <!-- Left: Presets & Custom Rows x Columns -->
                <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <!-- Label -->
                        <TextBlock Text="Lưới:" Foreground="{DynamicResource ThemeTextSecondaryBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,2,0"/>

                        <!-- Preset Buttons: MinWidth="48", Height="30", Padding="6,2" so text is NEVER cut off -->
                        <Button x:Name="BtnGrid1x1" Content="1×1" MinWidth="48" Height="30" Padding="6,2"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center" CornerRadius="4"
                                Background="{DynamicResource ThemeButtonSecondaryBackgroundBrush}"
                                Foreground="{DynamicResource ThemeButtonSecondaryForegroundBrush}"
                                BorderBrush="{DynamicResource ThemeButtonSecondaryBorderBrush}"
                                BorderThickness="1" FontSize="12" ToolTip.Tip="Lưới 1×1 (1 ô)"/>

                        <Button x:Name="BtnGrid2x2" Content="2×2" MinWidth="48" Height="30" Padding="6,2"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center" CornerRadius="4"
                                Background="#2563EB" Foreground="White"
                                BorderThickness="0" FontSize="12" ToolTip.Tip="Lưới 2×2 (4 ô)"/>

                        <Button x:Name="BtnGrid3x3" Content="3×3" MinWidth="48" Height="30" Padding="6,2"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center" CornerRadius="4"
                                Background="{DynamicResource ThemeButtonSecondaryBackgroundBrush}"
                                Foreground="{DynamicResource ThemeButtonSecondaryForegroundBrush}"
                                BorderBrush="{DynamicResource ThemeButtonSecondaryBorderBrush}"
                                BorderThickness="1" FontSize="12" ToolTip.Tip="Lưới 3×3 (9 ô)"/>

                        <Button x:Name="BtnGrid4x4" Content="4×4" MinWidth="48" Height="30" Padding="6,2"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center" CornerRadius="4"
                                Background="{DynamicResource ThemeButtonSecondaryBackgroundBrush}"
                                Foreground="{DynamicResource ThemeButtonSecondaryForegroundBrush}"
                                BorderBrush="{DynamicResource ThemeButtonSecondaryBorderBrush}"
                                BorderThickness="1" FontSize="12" ToolTip.Tip="Lưới 4×4 (16 ô)"/>

                        <Button x:Name="BtnGrid2x3" Content="2×3" MinWidth="48" Height="30" Padding="6,2"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center" CornerRadius="4"
                                Background="{DynamicResource ThemeButtonSecondaryBackgroundBrush}"
                                Foreground="{DynamicResource ThemeButtonSecondaryForegroundBrush}"
                                BorderBrush="{DynamicResource ThemeButtonSecondaryBorderBrush}"
                                BorderThickness="1" FontSize="12" ToolTip.Tip="Lưới 2 hàng × 3 cột (6 ô)"/>

                        <Button x:Name="BtnGrid2x4" Content="2×4" MinWidth="48" Height="30" Padding="6,2"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center" CornerRadius="4"
                                Background="{DynamicResource ThemeButtonSecondaryBackgroundBrush}"
                                Foreground="{DynamicResource ThemeButtonSecondaryForegroundBrush}"
                                BorderBrush="{DynamicResource ThemeButtonSecondaryBorderBrush}"
                                BorderThickness="1" FontSize="12" ToolTip.Tip="Lưới 2 hàng × 4 cột (8 ô)"/>

                        <Button x:Name="BtnGrid3x4" Content="3×4" MinWidth="48" Height="30" Padding="6,2"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center" CornerRadius="4"
                                Background="{DynamicResource ThemeButtonSecondaryBackgroundBrush}"
                                Foreground="{DynamicResource ThemeButtonSecondaryForegroundBrush}"
                                BorderBrush="{DynamicResource ThemeButtonSecondaryBorderBrush}"
                                BorderThickness="1" FontSize="12" ToolTip.Tip="Lưới 3 hàng × 4 cột (12 ô)"/>

                        <!-- Vertical Separator -->
                        <Border Width="1" Height="20" Background="{DynamicResource ThemeButtonSecondaryBorderBrush}" Margin="4,0"/>

                        <!-- Custom Rows & Cols Picker -->
                        <TextBlock Text="Tùy chỉnh:" Foreground="{DynamicResource ThemeTextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Text="Hàng" Foreground="{DynamicResource ThemeTextMutedBrush}" FontSize="11" VerticalAlignment="Center"/>
                        <NumericUpDown x:Name="NumRows" Minimum="1" Maximum="10" Value="2" FormatString="0"
                                       Width="105" Height="30" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                       Padding="8,0" ToolTip.Tip="Số hàng (1 - 10)"/>
                        <TextBlock Text="×" Foreground="{DynamicResource ThemeTextSecondaryBrush}" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock Text="Cột" Foreground="{DynamicResource ThemeTextMutedBrush}" FontSize="11" VerticalAlignment="Center"/>
                        <NumericUpDown x:Name="NumCols" Minimum="1" Maximum="10" Value="2" FormatString="0"
                                       Width="105" Height="30" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                       Padding="8,0" ToolTip.Tip="Số cột (1 - 10)"/>
                        <Button x:Name="BtnApplyCustomGrid" Content="Áp dụng" Height="30" Padding="10,2"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Background="{DynamicResource ThemeButtonSecondaryBackgroundBrush}"
                                Foreground="{DynamicResource ThemeButtonSecondaryForegroundBrush}"
                                BorderBrush="{DynamicResource ThemeButtonSecondaryBorderBrush}"
                                BorderThickness="1" CornerRadius="4" FontSize="12" ToolTip.Tip="Áp dụng số hàng và cột tùy chỉnh"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Right: Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="8,0,0,0">
                    <Button x:Name="BtnRecordAll" Content="⏺️ Record All" Height="30" Padding="12,2"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            Background="#DC2626" Foreground="White" CornerRadius="4" FontSize="12"/>
                    <Button x:Name="BtnStopAll" Content="⏹️ Stop All" Height="30" Padding="12,2"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            Background="{DynamicResource ThemeButtonSecondaryBackgroundBrush}"
                            Foreground="{DynamicResource ThemeButtonSecondaryForegroundBrush}"
                            BorderBrush="{DynamicResource ThemeButtonSecondaryBorderBrush}"
                            BorderThickness="1" CornerRadius="4" FontSize="12"/>
                    <Button x:Name="BtnAutoFill" Content="▶️ Play All" Height="30" Padding="12,2"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            Background="#059669" Foreground="White" CornerRadius="4" FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
