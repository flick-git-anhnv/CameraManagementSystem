<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CMS.App.ViewModels"
             x:Class="CMS.App.Views.AlarmCenterView"
             x:DataType="vm:AlarmCenterViewModel">

    <Grid RowDefinitions="Auto, Auto, *" Margin="12">
        <!-- 1. Top Controls Bar -->
        <Border Grid.Row="0" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,10">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="🚨" FontSize="20" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ALARM &amp; SECURITY EVENT CENTER" FontWeight="Bold" FontSize="14" Foreground="White"/>
                        <TextBlock Text="{Binding StatusSummary}" FontSize="11" Foreground="#A1A1AA"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <!-- Filter Camera -->
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="Camera:" FontSize="12" Foreground="#A1A1AA" VerticalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding CameraOptions}" SelectedItem="{Binding FilterCamera}" Width="160" Height="32"/>
                    </StackPanel>

                    <Button Content="🔄 Refresh" Command="{Binding LoadAlarmsCommand}" Background="#27272A" Foreground="White" Padding="12,6" FontSize="12"/>
                    <Button Content="✔ Acknowledge All" Command="{Binding AcknowledgeAllCommand}" Background="#059669" Foreground="White" FontWeight="SemiBold" Padding="12,6" FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Alarm Status KPI Cards -->
        <Grid Grid.Row="1" ColumnDefinitions="*, *, *, *" Margin="0,0,0,10">
            <Border Grid.Column="0" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,4,0">
                <StackPanel Spacing="4">
                    <TextBlock Text="TOTAL LOGGED ALARMS" FontSize="10" FontWeight="SemiBold" Foreground="#71717A"/>
                    <TextBlock Text="{Binding Alarms.Count}" FontSize="20" FontWeight="Bold" Foreground="White"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="#18181B" BorderBrush="#DC2626" BorderThickness="1" CornerRadius="6" Padding="12" Margin="4,0,4,0">
                <StackPanel Spacing="4">
                    <TextBlock Text="UNHANDLED ALERTS" FontSize="10" FontWeight="SemiBold" Foreground="#EF4444"/>
                    <TextBlock Text="{Binding UnreadCount}" FontSize="20" FontWeight="Bold" Foreground="#EF4444"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="6" Padding="12" Margin="4,0,4,0">
                <StackPanel Spacing="4">
                    <TextBlock Text="EDGE AI VEHICLE ALERTS" FontSize="10" FontWeight="SemiBold" Foreground="#3B82F6"/>
                    <TextBlock Text="Active" FontSize="20" FontWeight="Bold" Foreground="#3B82F6"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="6" Padding="12" Margin="4,0,0,0">
                <StackPanel Spacing="4">
                    <TextBlock Text="EDGE AI PERSON ALERTS" FontSize="10" FontWeight="SemiBold" Foreground="#10B981"/>
                    <TextBlock Text="Active" FontSize="20" FontWeight="Bold" Foreground="#10B981"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 3. Alarms List & Detail Splitter -->
        <Grid Grid.Row="2" ColumnDefinitions="*, 320">
            <!-- Left: Alarms Table -->
            <Border Grid.Column="0" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,8,0">
                <Grid RowDefinitions="Auto, *">
                    <!-- Column Headers -->
                    <Border Grid.Row="0" Background="#222225" CornerRadius="4" Padding="12,8" Margin="0,0,0,4">
                        <Grid ColumnDefinitions="40, 150, 150, 90, *, 100">
                            <TextBlock Grid.Column="0" Text="Type" FontWeight="Bold" FontSize="11" Foreground="#A1A1AA"/>
                            <TextBlock Grid.Column="1" Text="Time" FontWeight="Bold" FontSize="11" Foreground="#A1A1AA"/>
                            <TextBlock Grid.Column="2" Text="Camera" FontWeight="Bold" FontSize="11" Foreground="#A1A1AA"/>
                            <TextBlock Grid.Column="3" Text="Level" FontWeight="Bold" FontSize="11" Foreground="#A1A1AA"/>
                            <TextBlock Grid.Column="4" Text="Event Description" FontWeight="Bold" FontSize="11" Foreground="#A1A1AA"/>
                            <TextBlock Grid.Column="5" Text="Status" FontWeight="Bold" FontSize="11" Foreground="#A1A1AA" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <!-- Items List -->
                    <ScrollViewer Grid.Row="1">
                        <ListBox ItemsSource="{Binding FilteredAlarms}" SelectedItem="{Binding SelectedAlarm}" Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:AlarmItemViewModel">
                                    <Border Background="#1F1F23" CornerRadius="4" Padding="12,10" Margin="0,2">
                                        <Grid ColumnDefinitions="40, 150, 150, 90, *, 100">
                                            <!-- Icon -->
                                            <TextBlock Grid.Column="0" Text="{Binding EventTypeIcon}" FontSize="15" VerticalAlignment="Center"/>

                                            <!-- Time -->
                                            <TextBlock Grid.Column="1" Text="{Binding TimeFormatted}" FontSize="11" Foreground="#E4E4E7" VerticalAlignment="Center"/>

                                            <!-- Camera -->
                                            <TextBlock Grid.Column="2" Text="{Binding CameraName}" FontWeight="SemiBold" FontSize="12" Foreground="White" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                            <!-- Level Badge -->
                                            <Border Grid.Column="3" Background="{Binding LevelBadgeColor}" CornerRadius="3" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding LevelName}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                            </Border>

                                            <!-- Description -->
                                            <TextBlock Grid.Column="4" Text="{Binding Description}" FontSize="12" Foreground="#D4D4D8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>

                                            <!-- Status -->
                                            <StackPanel Grid.Column="5" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Border Background="#065F46" CornerRadius="3" Padding="6,2" IsVisible="{Binding IsHandled}">
                                                    <TextBlock Text="HANDLED" FontSize="9" FontWeight="Bold" Foreground="#34D399"/>
                                                </Border>
                                                <Border Background="#7F1D1D" CornerRadius="3" Padding="6,2" IsVisible="{Binding !IsHandled}">
                                                    <TextBlock Text="PENDING" FontSize="9" FontWeight="Bold" Foreground="#F87171"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Right: Alarm Detail & Snapshot Inspector -->
            <Border Grid.Column="1" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="6" Padding="12">
                <Grid RowDefinitions="Auto, *, Auto">
                    <TextBlock Grid.Row="0" Text="EVENT DETAILS" FontWeight="Bold" FontSize="12" Foreground="#3B82F6" Margin="0,0,0,10"/>

                    <!-- Detail Info -->
                    <ScrollViewer Grid.Row="1">
                        <StackPanel Spacing="10" IsVisible="{Binding SelectedAlarm, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <Border Background="#121214" CornerRadius="4" Padding="10">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Source Camera:" FontSize="11" Foreground="#A1A1AA"/>
                                    <TextBlock Text="{Binding SelectedAlarm.CameraName}" FontWeight="Bold" FontSize="13" Foreground="White"/>

                                    <TextBlock Text="Trigger Timestamp:" FontSize="11" Foreground="#A1A1AA" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding SelectedAlarm.TimeFormatted}" FontSize="12" Foreground="White"/>

                                    <TextBlock Text="Alert Severity:" FontSize="11" Foreground="#A1A1AA" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding SelectedAlarm.LevelName}" FontWeight="Bold" FontSize="12" Foreground="{Binding SelectedAlarm.LevelBadgeColor}"/>

                                    <TextBlock Text="Event Message:" FontSize="11" Foreground="#A1A1AA" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding SelectedAlarm.Description}" TextWrapping="Wrap" FontSize="12" Foreground="#E4E4E7"/>
                                </StackPanel>
                            </Border>

                            <!-- Snapshot Preview Placeholder -->
                            <Border Background="#09090B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="4" Height="150">
                                <Grid>
                                    <TextBlock Text="📷 Alarm Snapshot Preview&#x0a;(Captured at trigger time)" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Foreground="#71717A" FontSize="11"/>
                                </Grid>
                            </Border>

                            <Border Background="#121214" CornerRadius="4" Padding="10">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Handling Info:" FontSize="11" Foreground="#A1A1AA"/>
                                    <TextBlock Text="{Binding SelectedAlarm.HandledBy, FallbackValue='Not yet handled'}" FontSize="12" Foreground="#10B981" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Acknowledge Action Button -->
                    <Button Grid.Row="2" Content="✔ Acknowledge This Event" Command="{Binding AcknowledgeSelectedCommand}"
                            Background="#2563EB" Foreground="White" FontWeight="Bold"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="0,10"
                            IsEnabled="{Binding SelectedAlarm, Converter={x:Static ObjectConverters.IsNotNull}}" Margin="0,10,0,0"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
