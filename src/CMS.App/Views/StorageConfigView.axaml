<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CMS.App.ViewModels"
             xmlns:entities="using:CMS.Core.Entities"
             xmlns:kz="clr-namespace:KztekComponentAvalonia.Controls;assembly=KztekComponentAvalonia"
             x:Class="CMS.App.Views.StorageConfigView"
             x:DataType="vm:StorageConfigViewModel">

    <ScrollViewer Margin="16">
        <StackPanel Spacing="16" MaxWidth="1100">
            <!-- ── Top Header ─────────────────────────────────────────────── -->
            <Border Background="{DynamicResource ThemeCardBackgroundBrush}" BorderBrush="{DynamicResource ThemeCardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18,14">
                <Grid ColumnDefinitions="*, Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="CẤU HÌNH LƯU TRỮ &amp; GHI HÌNH" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ThemeBrandBrush}"/>
                        <TextBlock Text="Quản lý ổ đĩa lưu trữ, phân vùng dung lượng, cơ chế tự động ghi đè FIFO và thiết lập lịch ghi hình từng camera." FontSize="12" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                    </StackPanel>
                    <kz:KzButton Grid.Column="1" Content="💾 Lưu cài đặt lưu trữ" 
                                 Command="{Binding SaveSettingsCommand}"
                                 Variant="Primary" KzSize="Md"/>
                </Grid>
            </Border>

            <!-- ── Card 1: Disks Overview & Quick Select ─────────────────── -->
            <Border Background="{DynamicResource ThemeCardBackgroundBrush}" BorderBrush="{DynamicResource ThemeCardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock Grid.Column="0" Text="Ổ ĐĨA LƯU TRỮ CỤC BỘ" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding RecordedSizeFormatted, StringFormat='Tổng dung lượng video đã ghi: {0}'}" FontSize="12" Foreground="#10B981" FontWeight="SemiBold"/>
                    </Grid>

                    <!-- Drive cards list -->
                    <ItemsControl ItemsSource="{Binding AvailableDrives}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DriveDisplayInfo">
                                <Border Background="{DynamicResource ThemeItemContainerBackgroundBrush}" CornerRadius="6" Padding="14,12" Margin="0,3" BorderBrush="{DynamicResource ThemeItemContainerBorderBrush}" BorderThickness="1">
                                    <Grid ColumnDefinitions="Auto, *, 220, Auto">
                                        <!-- Drive Icon -->
                                        <TextBlock Grid.Column="0" Text="🖴" FontSize="26" VerticalAlignment="Center" Margin="0,0,14,0"/>

                                        <!-- Drive info -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayText}" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontSize="13"/>
                                            <TextBlock Text="Phân vùng lưu trữ hệ điều hành" FontSize="11" Foreground="{DynamicResource ThemeTextMutedBrush}"/>
                                        </StackPanel>

                                        <!-- Progress Bar -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="14,0">
                                            <ProgressBar Value="{Binding UsedPercent}" Maximum="100" Height="8" CornerRadius="4" Foreground="#F05922" Background="{DynamicResource ThemeButtonSecondaryBackgroundBrush}"/>
                                        </StackPanel>

                                        <!-- Select Button -->
                                        <kz:KzButton Grid.Column="3" Content="Sử dụng ổ này" 
                                                     Command="{Binding $parent[UserControl].((vm:StorageConfigViewModel)DataContext).SelectDriveAsStorageCommand}"
                                                     CommandParameter="{Binding}"
                                                     Variant="Secondary" KzSize="Sm" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ── Card 2: General Storage Policy ────────────────────────── -->
            <Border Background="{DynamicResource ThemeCardBackgroundBrush}" BorderBrush="{DynamicResource ThemeCardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18">
                <StackPanel Spacing="14">
                    <TextBlock Text="CHÍNH SÁCH LƯU TRỮ &amp; VÒNG ĐỜI BẢN GHI" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>

                    <!-- Root Storage Path -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Đường dẫn thư mục lưu trữ video:" FontSize="12" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                        <kz:KzTextBox Text="{Binding RootStoragePath}" PlaceholderText="Ví dụ: D:\CMS_Recordings" KzSize="Md"/>
                    </StackPanel>

                    <!-- Parameters Grid -->
                    <Grid ColumnDefinitions="*, *, *">
                        <!-- Segment Duration -->
                        <StackPanel Grid.Column="0" Margin="0,0,10,0" Spacing="4">
                            <TextBlock Text="Thời lượng mỗi đoạn video:" FontSize="12" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                            <ComboBox ItemsSource="{Binding AvailableSegmentDurations}" SelectedItem="{Binding SegmentDurationMinutes}" HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StringFormat='{}{0} Phút / Tệp'}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <!-- Min Free Space -->
                        <StackPanel Grid.Column="1" Margin="0,0,10,0" Spacing="4">
                            <TextBlock Text="Dung lượng trống tối thiểu (Ghi đè):" FontSize="12" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                            <ComboBox ItemsSource="{Binding AvailableMinFreeSpaces}" SelectedItem="{Binding MinFreeSpaceGigabytes}" HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StringFormat='Tối thiểu {0} GB trống'}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <!-- Retention Days -->
                        <StackPanel Grid.Column="2" Spacing="4">
                            <TextBlock Text="Thời gian lưu trữ tối đa:" FontSize="12" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                            <ComboBox ItemsSource="{Binding AvailableRetentionDays}" SelectedItem="{Binding RetentionDays}" HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StringFormat='{}{0} Ngày'}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- Auto Overwrite Switch -->
                    <CheckBox IsChecked="{Binding AutoOverwriteOldest}" Margin="0,4,0,0">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Kích hoạt tự động ghi đè theo cơ chế FIFO (Khuyến nghị)" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                            <TextBlock Text="Hệ thống tự động xóa bản ghi video cũ nhất khi dung lượng ổ đĩa giảm xuống dưới ngưỡng an toàn đã đặt." FontSize="11" Foreground="{DynamicResource ThemeTextMutedBrush}"/>
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </Border>

            <!-- ── Card 3: Camera Recording Policy Table ─────────────────── -->
            <Border Background="{DynamicResource ThemeCardBackgroundBrush}" BorderBrush="{DynamicResource ThemeCardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18">
                <StackPanel Spacing="12">
                    <TextBlock Text="LỊCH TRÌNH GHI HÌNH &amp; THIẾT LẬP LUỒNG CAMERA" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>

                    <!-- Cameras Table -->
                    <Border Background="{DynamicResource ThemeCardSecondaryBackgroundBrush}" CornerRadius="6" BorderBrush="{DynamicResource ThemeCardBorderBrush}" BorderThickness="1" Padding="10">
                        <ItemsControl ItemsSource="{Binding CameraPolicies}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CameraRecordingPolicyItem">
                                    <Border Background="{DynamicResource ThemeItemContainerBackgroundBrush}" CornerRadius="6" Padding="14,12" Margin="0,4" BorderBrush="{DynamicResource ThemeItemContainerBorderBrush}" BorderThickness="1">
                                        <StackPanel Spacing="10">
                                            <!-- Main Row -->
                                            <Grid ColumnDefinitions="Auto, *, 250, 220">
                                                <!-- Camera Icon & Info -->
                                                <TextBlock Grid.Column="0" Text="📹" FontSize="20" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding RecordingStatusText}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding RecordingStatusColor}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding IpAddress, StringFormat='IP: {0}'}" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                                </StackPanel>

                                                <!-- Recording Mode Selector (Việt hóa) -->
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,16,0" Spacing="3">
                                                    <TextBlock Text="Chế độ ghi hình:" FontSize="11" Foreground="{DynamicResource ThemeTextMutedBrush}"/>
                                                    <ComboBox ItemsSource="{Binding $parent[UserControl].((vm:StorageConfigViewModel)DataContext).AvailableRecordModeOptions}"
                                                              SelectedItem="{Binding SelectedRecordModeOption}"
                                                              HorizontalAlignment="Stretch">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:RecordingModeOption">
                                                                <TextBlock Text="{Binding DisplayName}"/>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                </StackPanel>

                                                <!-- Stream Selection -->
                                                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                    <CheckBox Content="Ghi luồng phụ (Tiết kiệm dung lượng)" IsChecked="{Binding RecordSubStream}" FontSize="12"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Schedule Configuration Row (Only visible when RecordMode == Schedule) -->
                                            <Border IsVisible="{Binding IsScheduleMode}"
                                                    Background="{DynamicResource ThemeCardSecondaryBackgroundBrush}"
                                                    BorderBrush="{DynamicResource ThemeCardBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="12,10"
                                                    Margin="32,2,0,0">
                                                <Grid ColumnDefinitions="Auto, 110, Auto, 110, 24, Auto, *">
                                                    <TextBlock Grid.Column="0" Text="🕒 Khung giờ ghi:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <ComboBox Grid.Column="1"
                                                              ItemsSource="{Binding $parent[UserControl].((vm:StorageConfigViewModel)DataContext).AvailableTimeSlots}"
                                                              SelectedItem="{Binding ScheduleStartTime}"
                                                              HorizontalAlignment="Stretch"
                                                              VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="đến" FontSize="12" Foreground="{DynamicResource ThemeTextMutedBrush}" VerticalAlignment="Center" Margin="8,0"/>
                                                    <ComboBox Grid.Column="3"
                                                              ItemsSource="{Binding $parent[UserControl].((vm:StorageConfigViewModel)DataContext).AvailableTimeSlots}"
                                                              SelectedItem="{Binding ScheduleEndTime}"
                                                              HorizontalAlignment="Stretch"
                                                              VerticalAlignment="Center"/>

                                                    <TextBlock Grid.Column="5" Text="📅 Ngày trong tuần:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                    <WrapPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <CheckBox Content="T2" IsChecked="{Binding IsMon}" Margin="0,0,10,0" FontSize="12"/>
                                                        <CheckBox Content="T3" IsChecked="{Binding IsTue}" Margin="0,0,10,0" FontSize="12"/>
                                                        <CheckBox Content="T4" IsChecked="{Binding IsWed}" Margin="0,0,10,0" FontSize="12"/>
                                                        <CheckBox Content="T5" IsChecked="{Binding IsThu}" Margin="0,0,10,0" FontSize="12"/>
                                                        <CheckBox Content="T6" IsChecked="{Binding IsFri}" Margin="0,0,10,0" FontSize="12"/>
                                                        <CheckBox Content="T7" IsChecked="{Binding IsSat}" Margin="0,0,10,0" FontSize="12"/>
                                                        <CheckBox Content="CN" IsChecked="{Binding IsSun}" FontSize="12"/>
                                                    </WrapPanel>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <!-- Status Notification Banner -->
                    <Border Background="{DynamicResource ThemeNotificationBackgroundBrush}" BorderBrush="{DynamicResource ThemeCardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,8,0,0" IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource ThemeNotificationForegroundBrush}" FontSize="12"/>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
