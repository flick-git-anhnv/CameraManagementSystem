<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CMS.App.ViewModels"
             xmlns:entities="using:CMS.Core.Entities"
             xmlns:kz="clr-namespace:KztekComponentAvalonia.Controls;assembly=KztekComponentAvalonia"
             x:Class="CMS.App.Views.DeviceManagementView"
             x:DataType="vm:DeviceManagementViewModel">

    <UserControl.Styles>
        <Style Selector="Border.camera-card">
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeItemContainerBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Border.camera-card.editing">
            <Setter Property="BorderBrush" Value="#F05922"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
    </UserControl.Styles>

    <Grid Margin="14" RowDefinitions="Auto, *">
        <!-- ── 1. Top Header ─────────────────────────────────────────────── -->
        <Border Grid.Row="0"
                Background="{DynamicResource ThemeCardBackgroundBrush}"
                CornerRadius="8"
                Padding="16,12"
                Margin="0,0,0,10"
                BorderBrush="{DynamicResource ThemeCardBorderBrush}"
                BorderThickness="1">
            <Grid ColumnDefinitions="*, Auto">
                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="QUẢN LÝ THIẾT BỊ CAMERA"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{DynamicResource ThemeBrandBrush}"/>
                    <TextBlock Text="Tự động dò quét ONVIF, thêm nhanh thiết bị và giám sát trạng thái kết nối thời gian thực."
                               FontSize="12"
                               Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <kz:KzButton Content="⚡ Thêm nhanh"
                                 Command="{Binding OpenQuickAddDialogCommand}"
                                 Variant="Primary"
                                 KzSize="Md"
                                 ToolTip.Tip="Mở hộp thoại thêm nhanh hàng loạt theo dải IP hoặc các camera ONVIF đã chọn"/>
                    <kz:KzButton Content="🔍 Quét ONVIF (LAN)"
                                 Command="{Binding ScanOnvifDevicesCommand}"
                                 IsEnabled="{Binding !IsScanning}"
                                 Variant="Secondary"
                                 KzSize="Md"/>
                    <kz:KzButton Content="🔌 Kiểm tra kết nối tất cả"
                                 Command="{Binding CheckAllConnectionsCommand}"
                                 IsEnabled="{Binding !IsCheckingAll}"
                                 Variant="Secondary"
                                 KzSize="Md"
                                 ToolTip.Tip="Kiểm tra trạng thái kết nối trực tuyến của toàn bộ camera đã cấu hình"/>
                    <kz:KzButton Content="🔄 Làm mới"
                                 Command="{Binding LoadCamerasCommand}"
                                 Variant="Secondary"
                                 KzSize="Md"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── 2. Main Body ───────────────────────────────────────────────── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="420"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="380" MinWidth="320" MaxWidth="550"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Configured Cameras Grid & Discovered ONVIF Grid -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="180"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="220" MinHeight="140" MaxHeight="500"/>
                </Grid.RowDefinitions>

                <!-- ── 2A. Configured Cameras Section ────────────────────── -->
                <Border Grid.Row="0"
                        Background="{DynamicResource ThemeCardBackgroundBrush}"
                        CornerRadius="8"
                        BorderBrush="{DynamicResource ThemeCardBorderBrush}"
                        BorderThickness="1"
                        Padding="14,12">
                    <Grid RowDefinitions="Auto, Auto, *">
                        <!-- Header & Connection Summary Counters -->
                        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,8">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="CAMERA ĐÃ CẤU HÌNH TRONG HỆ THỐNG"
                                           FontWeight="Bold"
                                           FontSize="13"
                                           Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <kz:KzBadge Variant="Neutral"
                                            BadgeType="StatusPill"
                                            Content="{Binding TotalCamerasCount, StringFormat='Tổng: {0}'}"/>
                                <kz:KzBadge Variant="Success"
                                            BadgeType="StatusPill"
                                            Content="{Binding OnlineCamerasCount, StringFormat='● Kết nối: {0}'}"/>
                                <kz:KzBadge Variant="Error"
                                            BadgeType="StatusPill"
                                            Content="{Binding OfflineCamerasCount, StringFormat='● Mất kết nối: {0}'}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Search & Filter Bar for Configured Cameras -->
                        <Grid Grid.Row="1" ColumnDefinitions="*, 200, Auto" Margin="0,0,0,10">
                            <kz:KzTextBox Grid.Column="0"
                                          Text="{Binding CameraSearchText, Mode=TwoWay}"
                                          PlaceholderText="🔍 Tìm lọc camera theo tên, địa chỉ IP, hãng sản xuất..."
                                          KzSize="Md"
                                          FontSize="14"
                                          Margin="0,0,8,0"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding StatusFilterOptions}"
                                      SelectedItem="{Binding CameraStatusFilter, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch"
                                      MinHeight="40"
                                      FontSize="14"
                                      Margin="0,0,8,0"/>
                            <kz:KzButton Grid.Column="2"
                                         Content="{Binding CameraSortButtonText}"
                                         Command="{Binding ToggleCameraSortCommand}"
                                         Variant="Secondary"
                                         KzSize="Md"
                                         ToolTip.Tip="Chuyển đổi sắp xếp theo thứ tự IP tăng dần / giảm dần"/>
                        </Grid>

                        <!-- Empty State when no cameras configured -->
                        <Border Grid.Row="2"
                                IsVisible="{Binding !HasConfiguredCameras}"
                                Background="{DynamicResource ThemeItemContainerBackgroundBrush}"
                                BorderBrush="{DynamicResource ThemeItemContainerBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="24">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                                <TextBlock Text="📹" FontSize="28" HorizontalAlignment="Center"/>
                                <TextBlock Text="Chưa có camera nào được cấu hình trong hệ thống"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Hãy nhấn nút '⚡ Thêm nhanh' ở góc trên, quét ONVIF hoặc điền biểu mẫu bên phải."
                                           FontSize="12"
                                           Foreground="{DynamicResource ThemeTextMutedBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Configured Cameras 2-Column Card Grid -->
                        <ScrollViewer Grid.Row="2"
                                      IsVisible="{Binding HasConfiguredCameras}"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding FilteredCameras}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2" VerticalAlignment="Top"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="entities:CameraDevice">
                                        <Border Classes="camera-card"
                                                Classes.editing="{Binding IsBeingEdited}"
                                                Background="{DynamicResource ThemeItemContainerBackgroundBrush}"
                                                CornerRadius="8"
                                                Padding="12,10"
                                                Margin="4"
                                                Cursor="Hand"
                                                PointerPressed="OnCameraCardPointerPressed"
                                                ToolTip.Tip="Nhấn vào thẻ hoặc nút Sửa để chỉnh sửa thông tin camera này">
                                            <Grid RowDefinitions="Auto, Auto, Auto" RowSpacing="8">
                                                <!-- Card Row 0: Name, Brand & Live Connection Status Badge -->
                                                <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto">
                                                    <Border Grid.Column="0"
                                                            Background="{DynamicResource ThemeCardBackgroundBrush}"
                                                            BorderBrush="{DynamicResource ThemeCardBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Width="32" Height="32"
                                                            Margin="0,0,10,0"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="📹" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,6,0">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontWeight="Bold"
                                                                       FontSize="13.5"
                                                                       Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       MaxWidth="150"
                                                                       VerticalAlignment="Center"/>
                                                            <kz:KzBadge Variant="Accent"
                                                                        BadgeType="Tag"
                                                                        Content="{Binding Brand}"
                                                                        VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding IpAddress, StringFormat='🌐 IP: {0}'}"
                                                                   FontSize="12.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource ThemeBrandBrush}"/>
                                                    </StackPanel>

                                                    <!-- Connection Status Pill (Online / Checking / Offline) -->
                                                    <Panel Grid.Column="2" VerticalAlignment="Top">
                                                        <kz:KzBadge Variant="Success"
                                                                    BadgeType="StatusPill"
                                                                    Content="{Binding StatusText}"
                                                                    IsVisible="{Binding IsOnline}"/>
                                                        <kz:KzBadge Variant="Warning"
                                                                    BadgeType="StatusPill"
                                                                    Content="{Binding StatusText}"
                                                                    IsVisible="{Binding IsChecking}"/>
                                                        <kz:KzBadge Variant="Error"
                                                                    BadgeType="StatusPill"
                                                                    Content="{Binding StatusText}"
                                                                    IsVisible="{Binding IsOffline}"/>
                                                    </Panel>
                                                </Grid>

                                                <!-- Card Row 1: Technical Parameters Bar -->
                                                <Border Grid.Row="1"
                                                        Background="{DynamicResource ThemeCardBackgroundBrush}"
                                                        CornerRadius="6"
                                                        Padding="8,5">
                                                    <Grid ColumnDefinitions="*, Auto">
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding EndpointSummary}"
                                                                   FontSize="11.5"
                                                                   Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding CapabilitySummary}"
                                                                   FontSize="11.5"
                                                                   Foreground="{DynamicResource ThemeTextMutedBrush}"
                                                                   VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>

                                                <!-- Card Row 2: Connection Diagnostic & Action Buttons -->
                                                <Grid Grid.Row="2" ColumnDefinitions="*, Auto">
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding ConnectionStatusDetail}"
                                                               FontSize="11.5"
                                                               Foreground="{DynamicResource ThemeTextMutedBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,8,0"
                                                               ToolTip.Tip="{Binding ConnectionStatusDetail}"/>

                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                        <kz:KzButton Content="🔌 Kiểm tra"
                                                                     Click="OnCheckCameraConnectionClick"
                                                                     IsEnabled="{Binding !IsChecking}"
                                                                     Variant="Secondary"
                                                                     KzSize="Sm"
                                                                     ToolTip.Tip="Kiểm tra kết nối trực tiếp tới camera này"/>
                                                        <kz:KzButton Content="✏️ Sửa"
                                                                     Click="OnEditCameraClick"
                                                                     Variant="Secondary"
                                                                     KzSize="Sm"
                                                                     ToolTip.Tip="Chỉnh sửa thông số camera"/>
                                                        <kz:KzButton Content="🗑️"
                                                                     Click="OnDeleteCameraClick"
                                                                     Variant="Danger"
                                                                     KzSize="Sm"
                                                                     ToolTip.Tip="Xóa camera khỏi hệ thống"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Horizontal Splitter -->
                <GridSplitter x:Name="SplitterDiscoveredCameras" Grid.Row="1" Height="6" ResizeDirection="Rows" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="0,2"/>

                <!-- ── 2B. Discovered ONVIF Cameras Section ──────────────── -->
                <Border Grid.Row="2"
                        Background="{DynamicResource ThemeCardSecondaryBackgroundBrush}"
                        CornerRadius="8"
                        BorderBrush="{DynamicResource ThemeCardBorderBrush}"
                        BorderThickness="1"
                        Padding="14,12">
                    <Grid RowDefinitions="Auto, *">
                        <!-- Header with Filter, Sort & Selection actions -->
                        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,8">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock Text="CAMERA ONVIF TÌM THẤY TRÊN MẠNG"
                                           FontWeight="Bold"
                                           FontSize="13"
                                           Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                                <kz:KzBadge Variant="Info"
                                            BadgeType="StatusPill"
                                            Content="{Binding DiscoveredCount, StringFormat='{}{0} thiết bị'}"
                                            VerticalAlignment="Center"/>
                            </StackPanel>

                            <kz:KzTextBox Grid.Column="1"
                                          Text="{Binding DiscoveredSearchText, Mode=TwoWay}"
                                          PlaceholderText="🔍 Lọc thiết bị ONVIF theo IP, hãng, model..."
                                          KzSize="Md"
                                          FontSize="14"
                                          Margin="0,0,8,0"
                                          VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <kz:KzButton Content="{Binding DiscoveredSortButtonText}"
                                             Command="{Binding ToggleDiscoveredSortCommand}"
                                             IsVisible="{Binding HasDiscoveredDevices}"
                                             Variant="Secondary"
                                             KzSize="Sm"
                                             ToolTip.Tip="Chuyển đổi sắp xếp danh sách theo IP (Tăng dần / Giảm dần)"/>
                                <kz:KzButton Content="☑️ Chọn hết"
                                             Command="{Binding SelectAllDiscoveredCommand}"
                                             IsVisible="{Binding HasDiscoveredDevices}"
                                             Variant="Secondary"
                                             KzSize="Sm"
                                             ToolTip.Tip="Tích chọn toàn bộ thiết bị ONVIF chưa cấu hình"/>
                                <kz:KzButton Content="⬜ Bỏ chọn"
                                             Command="{Binding UnselectAllDiscoveredCommand}"
                                             IsVisible="{Binding HasDiscoveredDevices}"
                                             Variant="Secondary"
                                             KzSize="Sm"
                                             ToolTip.Tip="Bỏ tích chọn tất cả"/>
                                <kz:KzButton Content="{Binding BatchAddDiscoveredButtonText}"
                                             Command="{Binding BatchAddSelectedDiscoveredCommand}"
                                             IsVisible="{Binding HasDiscoveredDevices}"
                                             Variant="Primary"
                                             KzSize="Sm"
                                             ToolTip.Tip="Thêm hàng loạt các camera ONVIF đã tích chọn vào hệ thống"/>
                            </StackPanel>
                        </Grid>

                        <!-- Empty State when no discovered devices -->
                        <Border Grid.Row="1"
                                IsVisible="{Binding !HasDiscoveredDevices}"
                                Background="{DynamicResource ThemeItemContainerBackgroundBrush}"
                                BorderBrush="{DynamicResource ThemeItemContainerBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                                <TextBlock Text="📡 Chưa có danh sách thiết bị dò quét"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Nhấn '🔍 Quét ONVIF (LAN)' ở góc trên để phát hiện camera, sau đó tích chọn và nhấn Thêm hàng loạt."
                                           FontSize="12"
                                           Foreground="{DynamicResource ThemeTextMutedBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Discovered ONVIF 2-Column Compact Cards with Multi-Select CheckBox -->
                        <ScrollViewer Grid.Row="1"
                                      IsVisible="{Binding HasDiscoveredDevices}"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding FilteredDiscoveredDevices}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2" VerticalAlignment="Top"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="entities:DiscoveredDevice">
                                        <Border Background="{DynamicResource ThemeItemContainerBackgroundBrush}"
                                                BorderBrush="{DynamicResource ThemeItemContainerBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="12,9"
                                                Margin="4"
                                                Cursor="Hand"
                                                PointerPressed="OnDiscoveredCardPointerPressed"
                                                ToolTip.Tip="Tích chọn để thêm hàng loạt hoặc nhấn để điền thông tin">
                                            <Grid ColumnDefinitions="Auto, *, Auto">
                                                <!-- Left Multi-Select CheckBox -->
                                                <CheckBox Grid.Column="0"
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          IsEnabled="{Binding CanQuickAdd}"
                                                          Click="OnDiscoveredCheckBoxClick"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,8,0"
                                                          ToolTip.Tip="Chọn thiết bị này để thêm hàng loạt"/>

                                                <!-- Center IP, Model & Brand -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,8,0">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock Text="{Binding EndpointDisplay}"
                                                                   FontWeight="Bold"
                                                                   FontSize="13.5"
                                                                   Foreground="{DynamicResource ThemeBrandBrush}"
                                                                   VerticalAlignment="Center"/>
                                                        <kz:KzBadge Variant="Success"
                                                                    BadgeType="Tag"
                                                                    Content="{Binding DetectedBrand}"
                                                                    VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding DisplayModel, StringFormat='Model: {0}'}"
                                                               FontSize="11.5"
                                                               Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>

                                                <!-- Right Quick Actions -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                    <kz:KzButton Content="📝 Điền form"
                                                                 Click="OnSelectDiscoveredDeviceClick"
                                                                 Variant="Secondary"
                                                                 KzSize="Sm"
                                                                 ToolTip.Tip="Điền thông tin thiết bị này sang biểu mẫu bên phải"/>
                                                    <kz:KzButton Content="{Binding QuickAddButtonText}"
                                                                 Click="OnQuickAddDiscoveredDeviceClick"
                                                                 IsEnabled="{Binding CanQuickAdd}"
                                                                 Variant="Primary"
                                                                 KzSize="Sm"
                                                                 ToolTip.Tip="Thêm thiết bị này với cấu hình chung"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- Vertical Splitter -->
            <GridSplitter x:Name="SplitterConfigForm" Grid.Column="1" Width="6" ResizeDirection="Columns" HorizontalAlignment="Center" VerticalAlignment="Stretch" Margin="2,0"/>

            <!-- ── 2C. Right: Add / Edit Camera Form ─────────────────────── -->
            <Border Grid.Column="2"
                    Background="{DynamicResource ThemeCardBackgroundBrush}"
                    CornerRadius="8"
                    BorderBrush="{DynamicResource ThemeCardBorderBrush}"
                    BorderThickness="1"
                    Padding="16">
                <ScrollViewer>
                    <StackPanel Spacing="9">
                        <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,4">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding FormModeTitle}"
                                       FontWeight="Bold"
                                       FontSize="13"
                                       Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                            <kz:KzBadge Grid.Column="1"
                                        Variant="Accent"
                                        BadgeType="Tag"
                                        Content="Đang sửa"
                                        IsVisible="{Binding IsEditingExisting}"/>
                        </Grid>

                        <!-- Name -->
                        <TextBlock Text="Tên camera:" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                        <kz:KzTextBox Text="{Binding Name, Mode=TwoWay}" PlaceholderText="Ví dụ: Camera Cổng Chính" KzSize="Md" FontSize="14"/>

                        <!-- Brand -->
                        <TextBlock Text="Hãng sản xuất / Giao thức kết nối:" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                        <ComboBox ItemsSource="{Binding AvailableBrands}" SelectedItem="{Binding SelectedBrand, Mode=TwoWay}" HorizontalAlignment="Stretch" MinHeight="40" FontSize="14"/>

                        <!-- IP & Port -->
                        <Grid ColumnDefinitions="*, 95">
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Địa chỉ IP:" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                <kz:KzTextBox Text="{Binding IpAddress, Mode=TwoWay}" PlaceholderText="192.168.1.100" KzSize="Md" FontSize="14"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Cổng RTSP:" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                <kz:KzTextBox Text="{Binding RtspPort, Mode=TwoWay}" KzSize="Md" FontSize="14"/>
                            </StackPanel>
                        </Grid>

                        <!-- HTTP Port & Channel -->
                        <Grid ColumnDefinitions="*, *">
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Cổng HTTP:" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                <kz:KzTextBox Text="{Binding HttpPort, Mode=TwoWay}" KzSize="Md" FontSize="14"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Kênh (Channel):" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                <kz:KzTextBox Text="{Binding Channel, Mode=TwoWay}" KzSize="Md" FontSize="14"/>
                            </StackPanel>
                        </Grid>

                        <!-- Username & Password -->
                        <TextBlock Text="Tài khoản đăng nhập:" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                        <kz:KzTextBox Text="{Binding Username, Mode=TwoWay}" PlaceholderText="admin" KzSize="Md" FontSize="14"/>

                        <TextBlock Text="Mật khẩu:" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                        <kz:KzPasswordTextBox Text="{Binding Password, Mode=TwoWay}" Watermark="Nhập mật khẩu camera" KzSize="Md"/>

                        <!-- PTZ Capability Toggle -->
                        <CheckBox Content="Hỗ trợ điều khiển quay quét (PTZ)"
                                  IsChecked="{Binding HasPtz, Mode=TwoWay}"
                                  FontSize="13"
                                  Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                  Margin="0,2,0,0"/>

                        <!-- Buttons -->
                        <WrapPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <kz:KzButton Content="⚡ Kiểm tra kết nối"
                                         Command="{Binding TestConnectionCommand}"
                                         IsEnabled="{Binding !IsTesting}"
                                         Variant="Secondary"
                                         KzSize="Md"
                                         Margin="0,0,6,6"/>

                            <kz:KzButton Content="{Binding SaveButtonText}"
                                         Command="{Binding SaveCameraCommand}"
                                         Variant="Primary"
                                         KzSize="Md"
                                         Margin="0,0,6,6"/>

                            <kz:KzButton Content="Làm lại"
                                         Command="{Binding ResetFormCommand}"
                                         Variant="Ghost"
                                         KzSize="Md"
                                         Margin="0,0,0,6"/>
                        </WrapPanel>

                        <!-- Status Notification -->
                        <Border Background="{DynamicResource ThemeNotificationBackgroundBrush}"
                                BorderBrush="{DynamicResource ThemeCardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,10"
                                Margin="0,6,0,0"
                                IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Text="{Binding StatusMessage}"
                                       TextWrapping="Wrap"
                                       FontSize="12"
                                       Foreground="{DynamicResource ThemeNotificationForegroundBrush}"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ── 3. Quick-Add Modal Dialog (Hộp Thoại Thêm Nhanh Hàng Loạt) ── -->
        <Border Grid.Row="0" Grid.RowSpan="2"
                IsVisible="{Binding IsQuickAddDialogOpen}"
                Background="#990B0914"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                ZIndex="1000">
            <Border Background="{DynamicResource ThemeCardBackgroundBrush}"
                    BorderBrush="{DynamicResource ThemeCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Width="620"
                    MaxWidth="660"
                    Margin="20"
                    Padding="22"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BoxShadow="0 12 40 #70000000">
                <StackPanel Spacing="14">
                    <!-- Dialog Header -->
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="⚡ THÊM NHANH HÀNG LOẠT CAMERA"
                                       FontWeight="Bold"
                                       FontSize="15"
                                       Foreground="{DynamicResource ThemeBrandBrush}"/>
                            <TextBlock Text="Thêm đồng loạt camera theo dải địa chỉ IP hoặc từ danh sách ONVIF tìm thấy."
                                       FontSize="12"
                                       Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Content="✕"
                                Command="{Binding CloseQuickAddDialogCommand}"
                                Background="Transparent"
                                Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                FontSize="16"
                                FontWeight="Bold"
                                Padding="8,4"
                                Cursor="Hand"
                                ToolTip.Tip="Đóng hộp thoại"/>
                    </Grid>

                    <Separator Background="{DynamicResource ThemeCardBorderBrush}" Height="1"/>

                    <!-- Dialog Form Fields -->
                    <StackPanel Spacing="10">
                        <!-- IP Range (Từ IP -> Đến IP) -->
                        <Grid ColumnDefinitions="*, *">
                            <StackPanel Grid.Column="0" Spacing="3" Margin="0,0,8,0">
                                <TextBlock Text="Từ địa chỉ IP (hoặc DS IP cách nhau dấu phẩy):" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                <kz:KzTextBox Text="{Binding BatchStartIp, Mode=TwoWay}"
                                              PlaceholderText="VD: 192.168.21.10"
                                              KzSize="Md"
                                              FontSize="14"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Text="Đến địa chỉ IP (hoặc số cuối):" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                <kz:KzTextBox Text="{Binding BatchEndIp, Mode=TwoWay}"
                                              PlaceholderText="VD: 192.168.21.20 hoặc 20"
                                              KzSize="Md"
                                              FontSize="14"/>
                            </StackPanel>
                        </Grid>

                        <!-- Name Prefix & Brand -->
                        <Grid ColumnDefinitions="*, *">
                            <StackPanel Grid.Column="0" Spacing="3" Margin="0,0,8,0">
                                <TextBlock Text="Tiền tố tên camera:" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                <kz:KzTextBox Text="{Binding BatchNamePrefix, Mode=TwoWay}"
                                              PlaceholderText="VD: Camera Khu A"
                                              KzSize="Md"
                                              FontSize="14"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Text="Hãng sản xuất / Giao thức:" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                <ComboBox ItemsSource="{Binding AvailableBrands}"
                                          SelectedItem="{Binding QuickAddBrand, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch"
                                          MinHeight="40"
                                          FontSize="14"/>
                            </StackPanel>
                        </Grid>

                        <!-- RTSP Port, HTTP Port, Channel -->
                        <Grid ColumnDefinitions="*, *, *">
                            <StackPanel Grid.Column="0" Spacing="3" Margin="0,0,8,0">
                                <TextBlock Text="Cổng RTSP:" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                <kz:KzTextBox Text="{Binding BatchRtspPort, Mode=TwoWay}" KzSize="Md" FontSize="14"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="3" Margin="0,0,8,0">
                                <TextBlock Text="Cổng HTTP:" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                <kz:KzTextBox Text="{Binding BatchHttpPort, Mode=TwoWay}" KzSize="Md" FontSize="14"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="3">
                                <TextBlock Text="Kênh (Channel):" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                <kz:KzTextBox Text="{Binding BatchChannel, Mode=TwoWay}" KzSize="Md" FontSize="14"/>
                            </StackPanel>
                        </Grid>

                        <!-- Username & Password using KzPasswordTextBox -->
                        <Grid ColumnDefinitions="*, *">
                            <StackPanel Grid.Column="0" Spacing="3" Margin="0,0,8,0">
                                <TextBlock Text="Tài khoản đăng nhập chung:" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                <kz:KzTextBox Text="{Binding QuickAddUsername, Mode=TwoWay}"
                                              PlaceholderText="admin"
                                              KzSize="Md"
                                              FontSize="14"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Text="Mật khẩu chung:" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                <kz:KzPasswordTextBox Text="{Binding QuickAddPassword, Mode=TwoWay}"
                                                      Watermark="Nhập mật khẩu loạt camera"
                                                      KzSize="Md"/>
                            </StackPanel>
                        </Grid>

                        <!-- PTZ CheckBox -->
                        <CheckBox Content="Hỗ trợ điều khiển quay quét (PTZ)"
                                  IsChecked="{Binding BatchHasPtz, Mode=TwoWay}"
                                  FontSize="13"
                                  Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                  Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Dialog Action Buttons -->
                    <Grid ColumnDefinitions="*, Auto" Margin="0,8,0,0">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                            <kz:KzButton Content="⚡ Thêm theo dải IP"
                                         Command="{Binding BatchAddByIpRangeCommand}"
                                         Variant="Primary"
                                         KzSize="Md"
                                         ToolTip.Tip="Thêm toàn bộ camera trong dải IP từ IP bắt đầu đến IP kết thúc"/>
                            <kz:KzButton Content="{Binding BatchAddDiscoveredButtonText}"
                                         Command="{Binding BatchAddSelectedDiscoveredCommand}"
                                         IsVisible="{Binding HasDiscoveredDevices}"
                                         Variant="Secondary"
                                         KzSize="Md"
                                         ToolTip.Tip="Thêm các camera ONVIF đang tích chọn với tài khoản/mật khẩu chung"/>
                        </StackPanel>

                        <kz:KzButton Grid.Column="1"
                                     Content="Đóng"
                                     Command="{Binding CloseQuickAddDialogCommand}"
                                     Variant="Ghost"
                                     KzSize="Md"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
