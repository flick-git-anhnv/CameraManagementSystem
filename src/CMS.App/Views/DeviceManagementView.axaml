<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CMS.App.ViewModels"
             xmlns:entities="using:CMS.Core.Entities"
             x:Class="CMS.App.Views.DeviceManagementView"
             x:DataType="vm:DeviceManagementViewModel">

    <Grid Margin="16" RowDefinitions="Auto, *">
        <!-- Header -->
        <Border Grid.Row="0" Background="#222222" CornerRadius="6" Padding="16,12" Margin="0,0,0,12" BorderBrush="#333333" BorderThickness="1">
            <Grid ColumnDefinitions="*, Auto">
                <StackPanel Grid.Column="0">
                    <TextBlock Text="CAMERA DEVICE MANAGEMENT" FontSize="16" FontWeight="Bold" Foreground="#3B82F6"/>
                    <TextBlock Text="Add, discover via ONVIF, and configure multi-brand camera connections." FontSize="12" Foreground="#888888"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="🔍 Scan ONVIF (LAN)" 
                            Command="{Binding ScanOnvifDevicesCommand}"
                            IsEnabled="{Binding !IsScanning}"
                            Background="#2563EB" Foreground="White" Padding="12,6"/>
                    <Button Content="🔄 Refresh" 
                            Command="{Binding LoadCamerasCommand}"
                            Background="#333333" Foreground="White" Padding="12,6"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Body -->
        <Grid Grid.Row="1" ColumnDefinitions="*, 380">
            <!-- Left: Configured Cameras List & Discovered List -->
            <Grid Grid.Column="0" RowDefinitions="*, Auto, 180" Margin="0,0,12,0">
                <!-- Configured Cameras -->
                <Border Grid.Row="0" Background="#1E1E1E" CornerRadius="6" BorderBrush="#333333" BorderThickness="1" Padding="12">
                    <Grid RowDefinitions="Auto, *">
                        <TextBlock Grid.Row="0" Text="CONFIGURED CAMERAS" FontWeight="SemiBold" FontSize="13" Foreground="#A0A0A0" Margin="0,0,0,8"/>
                        
                        <ListBox Grid.Row="1" ItemsSource="{Binding Cameras}" SelectedItem="{Binding SelectedCamera}" Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="entities:CameraDevice">
                                    <Border Background="#252526" CornerRadius="4" Padding="10,8" Margin="0,2" BorderBrush="#333333" BorderThickness="1">
                                        <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                                            <TextBlock Grid.Column="0" Text="📹" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                <TextBlock Text="{Binding IpAddress, StringFormat='IP: {0}'}" FontSize="12" Foreground="#888888"/>
                                            </StackPanel>
                                            <Border Grid.Column="2" Background="#1E3A8A" CornerRadius="3" Padding="6,2" VerticalAlignment="Center" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding Brand}" FontSize="11" Foreground="#93C5FD"/>
                                            </Border>
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <Button Content="✏️ Edit" 
                                                        Command="{Binding $parent[UserControl].((vm:DeviceManagementViewModel)DataContext).EditCameraCommand}"
                                                        CommandParameter="{Binding}"
                                                        Background="#333333" Padding="8,4" FontSize="11"/>
                                                <Button Content="🗑️" 
                                                        Command="{Binding $parent[UserControl].((vm:DeviceManagementViewModel)DataContext).DeleteCameraCommand}"
                                                        CommandParameter="{Binding}"
                                                        Background="#7F1D1D" Foreground="White" Padding="8,4" FontSize="11"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- Splitter Label -->
                <TextBlock Grid.Row="1" Text="DISCOVERED ONVIF CAMERAS (CLICK TO FILL FORM)" FontWeight="SemiBold" FontSize="11" Foreground="#888888" Margin="4,10,4,4"/>

                <!-- Discovered ONVIF Cameras -->
                <Border Grid.Row="2" Background="#1A1A1A" CornerRadius="6" BorderBrush="#2A2A2A" BorderThickness="1" Padding="8">
                    <ListBox ItemsSource="{Binding DiscoveredDevices}" SelectedItem="{Binding SelectedDiscoveredDevice}" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="entities:DiscoveredDevice">
                                <Button Command="{Binding $parent[UserControl].((vm:DeviceManagementViewModel)DataContext).SelectDiscoveredDeviceCommand}"
                                        CommandParameter="{Binding}"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                        Background="#222222" Margin="0,2" Padding="8,6">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding IPAddress, StringFormat='IP: {0}'}" FontWeight="Bold" Foreground="#3B82F6"/>
                                            <TextBlock Text="{Binding Model, StringFormat='Model: {0}'}" FontSize="11" Foreground="#AAAAAA"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding DetectedBrand}" Foreground="#10B981" FontSize="11" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>

            <!-- Right: Add / Edit Camera Form -->
            <Border Grid.Column="1" Background="#1E1E1E" CornerRadius="6" BorderBrush="#333333" BorderThickness="1" Padding="16">
                <ScrollViewer>
                    <StackPanel Spacing="10">
                        <TextBlock Text="CAMERA CONFIGURATION" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" Margin="0,0,0,4"/>

                        <!-- Name -->
                        <TextBlock Text="Camera Name" FontSize="12" Foreground="#AAAAAA"/>
                        <TextBox Text="{Binding Name}" PlaceholderText="e.g. Front Gate Camera"/>

                        <!-- Brand -->
                        <TextBlock Text="Brand / Protocol" FontSize="12" Foreground="#AAAAAA"/>
                        <ComboBox ItemsSource="{Binding AvailableBrands}" SelectedItem="{Binding SelectedBrand}" HorizontalAlignment="Stretch"/>

                        <!-- IP & Port -->
                        <Grid ColumnDefinitions="*, 80">
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="IP Address" FontSize="12" Foreground="#AAAAAA"/>
                                <TextBox Text="{Binding IpAddress}" PlaceholderText="192.168.1.100"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="RTSP Port" FontSize="12" Foreground="#AAAAAA"/>
                                <TextBox Text="{Binding RtspPort}"/>
                            </StackPanel>
                        </Grid>

                        <!-- HTTP Port & Channel -->
                        <Grid ColumnDefinitions="*, *">
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="HTTP Port" FontSize="12" Foreground="#AAAAAA"/>
                                <TextBox Text="{Binding HttpPort}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Channel" FontSize="12" Foreground="#AAAAAA"/>
                                <TextBox Text="{Binding Channel}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Username & Password -->
                        <TextBlock Text="Username" FontSize="12" Foreground="#AAAAAA"/>
                        <TextBox Text="{Binding Username}" PlaceholderText="admin"/>

                        <TextBlock Text="Password" FontSize="12" Foreground="#AAAAAA"/>
                        <TextBox Text="{Binding Password}" PasswordChar="•" PlaceholderText="Camera Password"/>

                        <!-- Buttons -->
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                            <Button Content="⚡ Test Connection" 
                                    Command="{Binding TestConnectionCommand}"
                                    IsEnabled="{Binding !IsTesting}"
                                    Background="#374151" Foreground="White" Padding="12,8"/>

                            <Button Content="💾 Save Camera" 
                                    Command="{Binding SaveCameraCommand}"
                                    Background="#059669" Foreground="White" FontWeight="Bold" Padding="14,8"/>
                            
                            <Button Content="Clear" 
                                    Command="{Binding ResetFormCommand}"
                                    Background="#222222" Padding="10,8"/>
                        </StackPanel>

                        <!-- Status Notification -->
                        <Border Background="#2A2A2A" CornerRadius="4" Padding="10,8" Margin="0,10,0,0" IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="12" Foreground="#E5E7EB"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
