<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CMS.App.ViewModels"
             xmlns:entities="using:CMS.Core.Entities"
             xmlns:kz="clr-namespace:KztekComponentAvalonia.Controls;assembly=KztekComponentAvalonia"
             x:Class="CMS.App.Views.DeviceManagementView"
             x:DataType="vm:DeviceManagementViewModel">

    <Grid Margin="16" RowDefinitions="Auto, *">
        <!-- ── Top Header ────────────────────────────────────────────────── -->
        <Border Grid.Row="0" Background="{DynamicResource ThemeCardBackgroundBrush}" CornerRadius="8" Padding="18,14" Margin="0,0,0,12" BorderBrush="{DynamicResource ThemeCardBorderBrush}" BorderThickness="1">
            <Grid ColumnDefinitions="*, Auto">
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="QUẢN LÝ THIẾT BỊ CAMERA" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ThemeBrandBrush}"/>
                    <TextBlock Text="Thêm mới, tự động dò quét thiết bị qua chuẩn ONVIF và cấu hình kết nối đa thương hiệu." FontSize="12" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <kz:KzButton Content="🔍 Quét ONVIF (LAN)" 
                                 Command="{Binding ScanOnvifDevicesCommand}"
                                 IsEnabled="{Binding !IsScanning}"
                                 Variant="Primary" KzSize="Md"/>
                    <kz:KzButton Content="🔄 Làm mới" 
                                 Command="{Binding LoadCamerasCommand}"
                                 Variant="Secondary" KzSize="Md"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Main Body ──────────────────────────────────────────────────── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="360"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="400" MinWidth="320" MaxWidth="650"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Configured Cameras List & Discovered List -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="160"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="220" MinHeight="120"/>
                </Grid.RowDefinitions>

                <!-- Configured Cameras -->
                <Border Grid.Row="0" Background="{DynamicResource ThemeCardBackgroundBrush}" CornerRadius="8" BorderBrush="{DynamicResource ThemeCardBorderBrush}" BorderThickness="1" Padding="14">
                    <Grid RowDefinitions="Auto, *">
                        <TextBlock Grid.Row="0" Text="CAMERA ĐÃ CẤU HÌNH TRONG HỆ THỐNG" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource ThemeTextMutedBrush}" Margin="0,0,0,10"/>
                        
                        <ListBox Grid.Row="1" ItemsSource="{Binding Cameras}" SelectedItem="{Binding SelectedCamera}" Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="entities:CameraDevice">
                                    <Border Background="{DynamicResource ThemeItemContainerBackgroundBrush}" CornerRadius="6" Padding="12,10" Margin="0,3" BorderBrush="{DynamicResource ThemeItemContainerBorderBrush}" BorderThickness="1">
                                        <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                                            <TextBlock Grid.Column="0" Text="📹" FontSize="20" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontSize="13"/>
                                                <TextBlock Text="{Binding IpAddress, StringFormat='IP: {0}'}" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                            </StackPanel>
                                            <kz:KzBadge Grid.Column="2" Variant="Accent" BadgeType="Tag" Content="{Binding Brand}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <kz:KzButton Content="✏️ Sửa" 
                                                             Command="{Binding $parent[UserControl].((vm:DeviceManagementViewModel)DataContext).EditCameraCommand}"
                                                             CommandParameter="{Binding}"
                                                             Variant="Secondary" KzSize="Sm"/>
                                                <kz:KzButton Content="🗑️" 
                                                             Command="{Binding $parent[UserControl].((vm:DeviceManagementViewModel)DataContext).DeleteCameraCommand}"
                                                             CommandParameter="{Binding}"
                                                             Variant="Danger" KzSize="Sm"
                                                             ToolTip.Tip="Xóa camera khỏi hệ thống"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- Horizontal Splitter -->
                <GridSplitter Grid.Row="1" Height="6" ResizeDirection="Rows" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="0,2"/>

                <!-- Discovered ONVIF Cameras -->
                <Border Grid.Row="2" Background="{DynamicResource ThemeCardSecondaryBackgroundBrush}" CornerRadius="8" BorderBrush="{DynamicResource ThemeCardBorderBrush}" BorderThickness="1" Padding="14">
                    <Grid RowDefinitions="Auto, *">
                        <TextBlock Grid.Row="0" Text="CAMERA ONVIF TÌM THẤY TRÊN MẠNG (NHẤN ĐỂ ĐIỀN THÔNG TIN)" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource ThemeTextMutedBrush}" Margin="0,0,0,8"/>
                        <ListBox Grid.Row="1" ItemsSource="{Binding DiscoveredDevices}" SelectedItem="{Binding SelectedDiscoveredDevice}" Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="entities:DiscoveredDevice">
                                    <Button Command="{Binding $parent[UserControl].((vm:DeviceManagementViewModel)DataContext).SelectDiscoveredDeviceCommand}"
                                            CommandParameter="{Binding}"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                            Background="{DynamicResource ThemeItemContainerBackgroundBrush}" 
                                            BorderBrush="{DynamicResource ThemeItemContainerBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Margin="0,2" Padding="10,8">
                                        <Grid ColumnDefinitions="*, Auto">
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding IPAddress, StringFormat='IP: {0}'}" FontWeight="Bold" Foreground="{DynamicResource ThemeBrandBrush}"/>
                                                <TextBlock Text="{Binding Model, StringFormat='Model: {0}'}" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                            </StackPanel>
                                            <kz:KzBadge Grid.Column="1" Variant="Success" BadgeType="Tag" Content="{Binding DetectedBrand}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>

            <!-- Vertical Splitter -->
            <GridSplitter Grid.Column="1" Width="6" ResizeDirection="Columns" HorizontalAlignment="Center" VerticalAlignment="Stretch" Margin="2,0"/>

            <!-- Right: Add / Edit Camera Form -->
            <Border Grid.Column="2" Background="{DynamicResource ThemeCardBackgroundBrush}" CornerRadius="8" BorderBrush="{DynamicResource ThemeCardBorderBrush}" BorderThickness="1" Padding="18">
                <ScrollViewer>
                    <StackPanel Spacing="10">
                        <TextBlock Text="CẤU HÌNH THÔNG TIN CAMERA" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource ThemeTextPrimaryBrush}" Margin="0,0,0,6"/>

                        <!-- Name -->
                        <TextBlock Text="Tên camera:" FontSize="12" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                        <kz:KzTextBox Text="{Binding Name}" PlaceholderText="Ví dụ: Camera Cổng Chính" KzSize="Md"/>

                        <!-- Brand -->
                        <TextBlock Text="Hãng sản xuất / Giao thức kết nối:" FontSize="12" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                        <ComboBox ItemsSource="{Binding AvailableBrands}" SelectedItem="{Binding SelectedBrand}" HorizontalAlignment="Stretch"/>

                        <!-- IP & Port -->
                        <Grid ColumnDefinitions="*, 90">
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Địa chỉ IP:" FontSize="12" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                <kz:KzTextBox Text="{Binding IpAddress}" PlaceholderText="192.168.1.100" KzSize="Md"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Cổng RTSP:" FontSize="12" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                <kz:KzTextBox Text="{Binding RtspPort}" KzSize="Md"/>
                            </StackPanel>
                        </Grid>

                        <!-- HTTP Port & Channel -->
                        <Grid ColumnDefinitions="*, *">
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Cổng HTTP:" FontSize="12" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                <kz:KzTextBox Text="{Binding HttpPort}" KzSize="Md"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Kênh (Channel):" FontSize="12" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                <kz:KzTextBox Text="{Binding Channel}" KzSize="Md"/>
                            </StackPanel>
                        </Grid>

                        <!-- Username & Password -->
                        <TextBlock Text="Tài khoản đăng nhập:" FontSize="12" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                        <kz:KzTextBox Text="{Binding Username}" PlaceholderText="admin" KzSize="Md"/>

                        <TextBlock Text="Mật khẩu:" FontSize="12" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                        <kz:KzTextBox Text="{Binding Password}" PasswordChar="●" PlaceholderText="Nhập mật khẩu camera" KzSize="Md"/>

                        <!-- Buttons -->
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                            <kz:KzButton Content="⚡ Kiểm tra kết nối" 
                                         Command="{Binding TestConnectionCommand}"
                                         IsEnabled="{Binding !IsTesting}"
                                         Variant="Secondary" KzSize="Md"/>

                            <kz:KzButton Content="💾 Lưu camera" 
                                         Command="{Binding SaveCameraCommand}"
                                         Variant="Primary" KzSize="Md"/>
                            
                            <kz:KzButton Content="Làm lại" 
                                         Command="{Binding ResetFormCommand}"
                                         Variant="Ghost" KzSize="Md"/>
                        </StackPanel>

                        <!-- Status Notification -->
                        <Border Background="{DynamicResource ThemeNotificationBackgroundBrush}" BorderBrush="{DynamicResource ThemeCardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,12,0,0" IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource ThemeNotificationForegroundBrush}"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
