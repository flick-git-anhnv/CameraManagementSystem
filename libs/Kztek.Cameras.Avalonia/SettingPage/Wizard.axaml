<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:kz="clr-namespace:KztekComponentAvalonia.Controls;assembly=KztekComponentAvalonia"
        x:Class="Kztek.Cameras.Wizard"
        Title="Wizard"
        Width="630" Height="480"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <!--
        Layout mirrors WinForms Wizard Form:
          descriptionLabel  → Border + TextBlock (DockPanel.Dock="Top",  H=65)
          workPanel         → ContentControl     (DockPanel LastChild Fill)
          panel1 (buttons)  → Border + Grid      (DockPanel.Dock="Bottom", H=57)
            [Back] [Next]   left group
            [Finish][Cancel] right group
    -->
    <DockPanel LastChildFill="True">

        <!-- Description banner (top) ─ WinForms: descriptionLabel, BorderStyle.FixedSingle, Dock=Top -->
        <Border DockPanel.Dock="Top"
                BorderBrush="#CBCBCB"
                BorderThickness="1"
                Height="65">
            <TextBlock x:Name="descriptionLabel"
                       FontFamily="Segoe UI Semibold"
                       FontWeight="Bold"
                       FontSize="16"
                       VerticalAlignment="Center"
                       Margin="10,0"/>
        </Border>

        <!-- Button panel (bottom) ─ WinForms: panel1, BorderStyle.FixedSingle, Dock=Bottom, H=57 -->
        <Border DockPanel.Dock="Bottom"
                BorderBrush="#CBCBCB"
                BorderThickness="1"
                Height="57">
            <Grid Margin="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Back + Next (left) ─ WinForms: btnBack @ x=7, btnNext @ x=128 -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <kz:KzButton x:Name="btnBack"
                                 Content="Quay lại"
                                 Width="94" Height="33"
                                 Click="BtnBack_Click"/>
                    <kz:KzButton x:Name="btnNext"
                                 Content="Tiếp tục"
                                 Width="94" Height="33"
                                 Click="BtnNext_Click"/>
                </StackPanel>

                <!-- Finish + Cancel (right) ─ WinForms: btnFinish @ x=385, btnCancel @ x=506 -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <kz:KzButton x:Name="btnFinish"
                                 Content="Hoàn thành"
                                 Width="94" Height="33"
                                 Click="BtnFinish_Click"/>
                    <kz:KzButton x:Name="btnCancel"
                                 Content="Hủy bỏ"
                                 Width="94" Height="33"
                                 Click="BtnCancel_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Work area (fill) ─ WinForms: workPanel (Panel, Dock=Fill).
             ContentControl shows one IWizardPage at a time; changing page =
             setting Content to the new page Control (no Add/Remove children). -->
        <ContentControl x:Name="workContent"/>

    </DockPanel>
</Window>
