<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- TFM trung lập (không windows) để build được linux-x64 -->
		<TargetFramework>net8.0</TargetFramework>
		<RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>

		<!-- Package metadata (giữ KZTEK per Assumption 2) -->
		<Authors>KZTEK-SOFTWARE</Authors>
		<Company>Kztek</Company>
		<PackageId>Kztek.Cameras.Avalonia</PackageId>
		<Version>0.1.0-alpha</Version>
		<AssemblyVersion>0.1.0.0</AssemblyVersion>
		<FileVersion>0.1.0.0</FileVersion>
		<Description>Kztek Camera library — Avalonia UI port (parallel to WinForms Kztek.Cameras)</Description>
		<Copyright>Kztek copyright</Copyright>
		<NoWarn>$(NoWarn);NU5100</NoWarn>

		<!-- KHÔNG UseWindowsForms, KHÔNG UseWPF -->
	</PropertyGroup>

	<ItemGroup>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
			<_Parameter1>Kztek.Cameras.Avalonia.Tests</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>

	<!-- Avalonia core (version pin 11.2.7 — khớp KztekComponentAvalonia.deps.json) -->
	<ItemGroup>
		<PackageReference Include="Avalonia" Version="12.1.2" />
		<PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
		<PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.2" />
		<!-- Dev tools chỉ trong Debug -->
	</ItemGroup>

	<!-- MVVM + Dialog + Graphics -->
	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="MsBox.Avalonia" Version="3.0.0-rc2" />
		<PackageReference Include="ReadPL" Version="1.1.3" />

	</ItemGroup>


	<!-- Business entities (cross-platform, giữ nguyên từ bản WinForms — D11 ADR §5.6) -->
	<!-- Cần cho MotionAnalyzingEventHandler.cs: GeneralEventArgs (namespace iParkingv5.Objects.Events) -->

	<!-- AI Detection — OpenVINO managed wrapper (G4.4: MolexDetection.cs).
	     Runtime native Windows (win-x64) + Linux target chính thức Ubuntu 22.04 x64
	     (Sdcb không publish gói "linux-x64" chung — mỗi distro có package riêng).
	     Version khớp với Kztek.Cameras WinForms (ADR §5.6 D-OV1, cập nhật sau merge). -->
	<ItemGroup>
		<PackageReference Include="Sdcb.OpenVINO" Version="0.8.1" />
		<PackageReference Include="Sdcb.OpenVINO.runtime.win-x64" Version="2026.2.0" />
		<PackageReference Include="Sdcb.OpenVINO.runtime.ubuntu.22.04-x64" Version="2026.2.0" />
	</ItemGroup>

	<!-- G4.3: FFMPEG service layer — OpenCV (motion detection), LPR SDK (ReadPL).
	     OpenCvSharp4: cross-platform managed assembly; runtime.win-x64 = native .dll cho Windows.
	     Linux runtime (.so) là deployment concern của consumer app (ADR §7 — future work).
	     ReadPL 1.0.8 (bản Multi-Platform): Recognize()/Plate.Crop dùng thẳng SkiaSharp.SKBitmap
	     — KHÔNG cần System.Drawing.Common nữa (2026-07-14, đã bỏ helper convert Bitmap cũ). -->
	<ItemGroup>
		<PackageReference Include="OpenCvSharp4" Version="4.13.0.20260627" />
		<PackageReference Include="Sdcb.OpenCvSharp4.mini.runtime.win-x64" Version="4.13.0.45" />
	</ItemGroup>


	<!-- KztekComponentAvalonia — pre-built DLL (Assumption 4, không có source trong repo) -->

	<!-- FFmpeg native DLL/EXE resources — Windows-only (win-x64).
	     Linux build pass nhưng runtime sẽ cần .so tương ứng (future work — ADR §7). -->
	<ItemGroup>
		<None Update="Players\FFMPEG\Resource\avcodec-61.dll">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="Players\FFMPEG\Resource\avdevice-61.dll">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="Players\FFMPEG\Resource\avfilter-10.dll">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="Players\FFMPEG\Resource\avformat-61.dll">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="Players\FFMPEG\Resource\avutil-59.dll">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="Players\FFMPEG\Resource\ffmpeg.exe">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="Players\FFMPEG\Resource\ffplay.exe">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="Players\FFMPEG\Resource\ffprobe.exe">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="Players\FFMPEG\Resource\postproc-58.dll">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="Players\FFMPEG\Resource\swresample-5.dll">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="Players\FFMPEG\Resource\swscale-8.dll">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<!-- FFmpeg native Linux (.so) — bổ sung 2026-07-14, cùng cây Resource/ với DLL Windows.
	     Nguồn: build FFmpeg riêng của user (avcodec/avdevice/avfilter/avformat/avutil/
	     swresample/swscale). LƯU Ý: version khác Windows (avcodec.so.62 vs avcodec-61.dll
	     Windows) — CHƯA verify tương thích ABI struct P/Invoke (Objects/AVCodecContext.cs...
	     viết theo layout FFmpeg 61). Xem ADR §7 R9.
	     KHÔNG commit .so vào git (2026-07-16): libavcodec.so > 100MB, GitHub từ chối push.
	     File .so KHÔNG nằm trong repo — copy thủ công vào Players/FFMPEG/Resource/ tại máy
	     dev/deploy Linux trước khi build/publish (giống pattern KztekComponentAvalonia).
	     Pattern <None Include> vẫn giữ để tự động CopyToOutputDirectory NẾU file có mặt cục bộ. -->
	<ItemGroup>
		<None Include="Players\FFMPEG\Resource\*.so*" Condition="Exists('Players\FFMPEG\Resource')">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>
	<ItemGroup>
	  <ProjectReference Include="..\KztekComponentAvalonia\KztekComponentAvalonia.csproj" />
	  <ProjectReference Include="..\Kztek.Object.MultyPlatform\Kztek.Object.MultyPlatform.csproj" />
	</ItemGroup>

</Project>
