<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:kz="clr-namespace:KztekComponentAvalonia.Controls">
    <Design.PreviewWith>
        <Border Padding="40" Background="#E8EAF0" MinWidth="440" MinHeight="240">
            <Border.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.MergedDictionaries>
                        <ResourceInclude Source="avares://KztekComponentAvalonia/Theme/KzTokens.axaml" />
                    </ResourceDictionary.MergedDictionaries>
                </ResourceDictionary>
            </Border.Resources>
            <Border.Styles>
                <Style Selector="kz|KzToggleSwitch">
                    <Setter Property="Theme" Value="{DynamicResource {x:Type kz:KzToggleSwitch}}" />
                </Style>
            </Border.Styles>
            <StackPanel Spacing="16" VerticalAlignment="Center">
                <kz:KzToggleSwitch Content="Tắt (mặc định)" />
                <kz:KzToggleSwitch Content="Bật" IsChecked="True" />
                <kz:KzToggleSwitch Content="Vô hiệu hoá — tắt" IsEnabled="False" />
                <kz:KzToggleSwitch Content="Vô hiệu hoá — bật" IsChecked="True" IsEnabled="False" />
            </StackPanel>
        </Border>
    </Design.PreviewWith>
    <!--
    Full custom template for KzToggleSwitch.
    PART_MovingKnobs is required by Avalonia's ToggleSwitch.OnApplyTemplate().
    Avalonia sets a TranslateTransform on PART_MovingKnobs to animate the slide.
    -->
    <ControlTheme x:Key="{x:Type kz:KzToggleSwitch}" TargetType="kz:KzToggleSwitch">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="OffContent" Value="" />
        <Setter Property="OnContent"  Value="" />
        <Setter Property="HorizontalAlignment" Value="Left" />

        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="Auto,Auto" VerticalAlignment="Center">
                    <!-- Track -->
                    <Grid Grid.Column="0" Width="52" Height="28">

                        <!-- Track background -->
                        <Border Name="PART_TrackBackground"
                                CornerRadius="14"
                                Background="{StaticResource kz.brush.navy.300}">
                            <Border.Transitions>
                                <Transitions>
                                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                                </Transitions>
                            </Border.Transitions>
                        </Border>

                        <!-- PART_MovingKnobs — must be Panel (Avalonia ToggleSwitch requirement) -->
                        <Panel Name="PART_MovingKnobs"
                               Width="22" Height="22"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Margin="3,0,0,0">
                            <Panel.RenderTransform>
                                <TranslateTransform X="0" />
                            </Panel.RenderTransform>
                            <Panel.Transitions>
                                <Transitions>
                                    <TransformOperationsTransition Property="RenderTransform"
                                                                   Duration="0:0:0.15"
                                                                   Easing="CubicEaseOut" />
                                </Transitions>
                            </Panel.Transitions>
                            <Ellipse Fill="White"
                                     Width="22" Height="22"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center" />
                        </Panel>
                    </Grid>

                    <!-- Content (on/off label) -->
                    <ContentPresenter Grid.Column="1"
                                      Content="{TemplateBinding Content}"
                                      Margin="8,0,0,0"
                                      VerticalAlignment="Center" />
                </Grid>
            </ControlTemplate>
        </Setter>

        <!-- ── ON state: navy bg, knob slides right ── -->
        <Style Selector="^:checked /template/ Border#PART_TrackBackground">
            <Setter Property="Background" Value="{StaticResource kz.brush.navy.900}" />
        </Style>
        <Style Selector="^:checked /template/ Border#PART_MovingKnobs">
            <Setter Property="RenderTransform" Value="translate(27px, 0px)" />
        </Style>

        <!-- ── Hover OFF ── -->
        <Style Selector="^:not(:checked):pointerover /template/ Border#PART_TrackBackground">
            <Setter Property="Background" Value="{StaticResource kz.brush.navy.700}" />
        </Style>

        <!-- ── Hover ON ── -->
        <Style Selector="^:checked:pointerover /template/ Border#PART_TrackBackground">
            <Setter Property="Background" Value="{StaticResource kz.brush.navy.hover}" />
        </Style>

        <!-- ── Disabled ── -->
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.45" />
        </Style>
    </ControlTheme>

</ResourceDictionary>
